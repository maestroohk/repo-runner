<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <!-- The startup hook ships inside the core library and is written to disk when a debug run needs it. -->
  <ItemGroup>
    <ProjectReference Include="..\RepoRunner.StartupHook\RepoRunner.StartupHook.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\RepoRunner.StartupHook\bin\$(Configuration)\net6.0\RepoRunner.StartupHook.dll" LogicalName="RepoRunner.StartupHook.dll" Visible="false" />
  </ItemGroup>

</Project>
