@page "/"
@implements IDisposable
@inject VaultService Vaults
@inject SessionManager Sessions
@inject IHostApplicationLifetime Lifetime
@inject IJSRuntime JS

<PageTitle>RepoRunner</PageTitle>

<div class="app">
    <aside class="sidebar">
        <div class="brand"><span class="logo"><Icon Name="play" Size="12" /></span>RepoRunner</div>

        <div class="nav-label">
            Repositories
            <button class="icon-btn" title="Add a repo" @onclick="OpenAdd"><Icon Name="plus" /></button>
        </div>

        @foreach (var r in repos)
        {
            var running = sessions.Any(s => s.Running && s.Repo == r.Name);
            <button class="repo-item @(repo?.Id == r.Id ? "active" : "")" @onclick="() => SelectRepo(r)">
                <span class="avatar" style="--hue:@Hue(r.Name)">@Initials(r.Name)</span>
                <span class="repo-text">
                    <span class="repo-name">@r.Name</span>
                    <span class="repo-sub">@(running ? "running" : r.DefaultEnv ?? "not run yet")</span>
                </span>
                @if (running)
                {
                    <span class="pulse"></span>
                }
            </button>
        }
        @if (repos.Count == 0 && !showAdd)
        {
            <div class="side-empty">No repositories yet.</div>
        }

        @if (showAdd)
        {
            <div class="add-form">
                <label class="field">
                    <span>Repo folder</span>
                    <input class="input" list="repo-folders" placeholder="C:\...\source\repos\MyApi" @bind="addPath" @bind:event="oninput" />
                </label>
                <datalist id="repo-folders">
                    @foreach (var folder in folderSuggestions)
                    {
                        <option value="@folder"></option>
                    }
                </datalist>
                <label class="field">
                    <span>Name (optional)</span>
                    <input class="input" placeholder="taken from the folder" @bind="addName" />
                </label>
                <div class="row">
                    <button class="btn primary small" @onclick="AddRepo">Add repo</button>
                    <button class="btn small" @onclick="() => showAdd = false">Cancel</button>
                </div>
            </div>
        }

        <div class="sidebar-foot">
            <div class="vault-pill" title="@Vaults.VaultFile"><Icon Name="shield" /> Vault encrypted</div>
            @if (unlocked.Count > 0)
            {
                <button class="foot-btn danger" @onclick="LockAll"><Icon Name="lock" /> Lock @string.Join(", ", unlocked) now</button>
            }
            <button class="foot-btn" @onclick="@(() => Confirm("quit", Quit))">
                <Icon Name="power" /> @(confirmKey == "quit" ? "Click again to quit" : "Quit RepoRunner")
            </button>
        </div>
    </aside>

    <main class="content">
        @if (repo is null)
        {
            <div class="welcome">
                <span class="logo"><Icon Name="play" Size="22" /></span>
                <h1>Run any repo on any environment</h1>
                <p>RepoRunner keeps each repo's variables in an encrypted vault and starts the app with them. No .env files, nothing set in Windows.</p>
                <button class="btn primary" @onclick="OpenAdd"><Icon Name="plus" /> Add your first repo</button>
            </div>
        }
        else
        {
            <div class="content-inner">
                <header class="page-head">
                    <div class="title-block">
                        <span class="avatar lg" style="--hue:@Hue(repo.Name)">@Initials(repo.Name)</span>
                        <div>
                            <h1>@repo.Name</h1>
                            <div class="path"><Icon Name="folder" Size="13" /> @repo.Path</div>
                        </div>
                    </div>
                    <div class="env-switch" role="tablist" aria-label="Environment">
                        @foreach (var e in envs)
                        {
                            <button class="env-opt tone-@Tone(e) @(e.Name == envName ? "active" : "")" role="tab" title="@EnvTitle(e)" @onclick="() => SelectEnv(e.Name)">
                                <span class="env-dot"></span>
                                @e.Name
                                @if (e.Protected)
                                {
                                    <Icon Name="@(Vaults.IsUnlocked(e) ? "unlock" : "lock")" Size="12" />
                                }
                                <span class="env-count">@(counts.GetValueOrDefault(e.Name))</span>
                            </button>
                        }
                    </div>
                </header>

                <section class="targets">
                    @if (targets.Count == 0)
                    {
                        <div class="panel">
                            <div class="state">
                                <span class="glyph"><Icon Name="terminal" Size="22" /></span>
                                <h3>No run targets found</h3>
                                <p>No runnable .NET project or npm dev script was detected in this folder.</p>
                            </div>
                        </div>
                    }
                    @foreach (var t in targets)
                    {
                        var live = sessions.FirstOrDefault(s => s.Running && s.Repo == repo.Name && s.Target == t.Name);
                        var missing = locked ? [] : t.Requires.Where(k => !vars.Any(v => v.Name.Equals(k, StringComparison.OrdinalIgnoreCase))).ToList();
                        <article class="target-card @(live is not null ? "live" : "")">
                            <div class="target-icon kind-@t.Kind">@(t.Kind == "dotnet" ? ".NET" : t.Kind == "node" ? "npm" : ">_")</div>
                            <div class="target-body">
                                <div class="target-title">
                                    @t.Name
                                    @if (t.Name.Equals(repo.DefaultTarget, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge accent">default</span>
                                    }
                                </div>
                                <div class="target-sub">
                                    @(t.Kind == "dotnet" ? t.Project : t.Kind == "node" ? $"npm run {t.Script}" : $"{t.Command} {string.Join(' ', t.Args)}")
                                    @if (t.Companions.Count > 0)
                                    {
                                        <span> · with @string.Join(", ", t.Companions)</span>
                                    }
                                </div>
                                @if (missing.Count > 0)
                                {
                                    <div class="target-warn"><Icon Name="alert" Size="14" /> @envName is missing @string.Join(", ", missing)</div>
                                }
                                @if (t.Kind == "dotnet" && solutions.Count > 1)
                                {
                                    <label class="solution-pick" title="Rider attaches in the window that has this solution open. Pick the one you work in.">
                                        <Icon Name="bug" Size="13" /> Debug with
                                        <select value="@SolutionOf(t)" @onchange="e => SetSolution(t, e.Value?.ToString())">
                                            @foreach (var sln in solutions)
                                            {
                                                <option value="@sln">@sln@(openInRider.Contains(sln) ? "  (open in Rider)" : "")</option>
                                            }
                                        </select>
                                    </label>
                                }
                            </div>
                            <div class="target-actions">
                                @if (live is not null)
                                {
                                    <span class="live-pill"><span class="pulse"></span> @live.Env · @Elapsed(live)</span>
                                    @if (live.Url is not null)
                                    {
                                        <a class="btn" href="@live.Url" target="_blank" rel="noopener">Open app <Icon Name="external" Size="14" /></a>
                                    }
                                    <button class="btn stop" @onclick="() => StopSession(live)"><Icon Name="stop" Size="12" /> Stop</button>
                                }
                                else
                                {
                                    <button class="btn @(IsConfirming(t, "Run") ? "confirm" : "run")" @onclick="@(() => Run(t, "Run"))">
                                        <Icon Name="play" Size="12" /> @RunLabel(t, "Run")
                                    </button>
                                    @if (t.Kind == "dotnet")
                                    {
                                        <button class="btn @(IsConfirming(t, "Debug") ? "confirm" : "")" title="Start paused and attach Rider's debugger" @onclick="@(() => Run(t, "Debug"))">
                                            <Icon Name="bug" Size="15" /> @RunLabel(t, "Debug")
                                        </button>
                                        <button class="btn @(IsConfirming(t, "Watch") ? "confirm" : "")" title="dotnet watch: rebuilds when files change" @onclick="@(() => Run(t, "Watch"))">
                                            <Icon Name="refresh" Size="14" /> @RunLabel(t, "Watch")
                                        </button>
                                    }
                                }
                            </div>
                        </article>
                    }
                </section>

                <section class="panel">
                    <div class="panel-tabs" role="tablist">
                        <button class="ptab @(tab == "vars" ? "active" : "")" @onclick="@(() => tab = "vars")">
                            <Icon Name="key" /> Variables <span class="tab-count">@(locked ? "–" : vars.Count.ToString())</span>
                        </button>
                        <button class="ptab @(tab == "output" ? "active" : "")" @onclick="@(() => tab = "output")">
                            <Icon Name="terminal" /> Output
                            @if (RepoSessions.Any(s => s.Running))
                            {
                                <span class="pulse"></span>
                            }
                        </button>
                        <button class="ptab @(tab == "flow" ? "active" : "")" @onclick="@(() => tab = "flow")">
                            <Icon Name="flow" /> Flow
                            @if (FlowList.Count(f => f.Outcome == "failed") is > 0 and var failedFlows)
                            {
                                <span class="tab-count bad">@failedFlows</span>
                            }
                            else if (FlowList.Count > 0)
                            {
                                <span class="tab-count">@FlowList.Count</span>
                            }
                        </button>
                        <button class="ptab @(tab == "files" ? "active" : "")" @onclick="@(() => tab = "files")">
                            <Icon Name="file" /> Plaintext files
                            @if (files.Count > 0)
                            {
                                <span class="tab-count warn">@files.Count</span>
                            }
                        </button>
                    </div>

                    <div class="panel-body">
                        @if (tab == "output")
                        {
                            @if (RepoSessions.Count == 0)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="terminal" Size="22" /></span>
                                    <h3>Nothing has run yet</h3>
                                    <p>Press Run on a target above. Its output streams here, with secret values masked.</p>
                                </div>
                            }
                            else
                            {
                                var view = LogView();
                                <div class="toolbar">
                                    @foreach (var s in RepoSessions)
                                    {
                                        <button class="session-chip @(s.Id == shown?.Id ? "active" : "")" @onclick="() => shown = s">
                                            @if (s.Running)
                                            {
                                                <span class="pulse"></span>
                                            }
                                            @s.Labels · @s.Env@(s.Running ? "" : " · ended")
                                        </button>
                                    }
                                    <span class="spacer"></span>
                                    <label class="check"><input type="checkbox" @bind="hideWarnings" /> Hide build warnings@(view.Hidden > 0 ? $" ({view.Hidden})" : "")</label>
                                    @if (shown is { Running: false })
                                    {
                                        <button class="btn small" @onclick="() => Dismiss(shown)">Clear</button>
                                    }
                                </div>
                                <div class="terminal">
                                    <div class="terminal-bar">
                                        <span class="terminal-dots"><i></i><i></i><i></i></span>
                                        <span>@(shown is null ? "" : $"{shown.Repo} · {shown.Labels} · {shown.Env} · started {shown.Started:HH:mm:ss}")</span>
                                    </div>
                                    <div class="log" @ref="logElement">
                                        @foreach (var line in view.Lines)
                                        {
                                            <div class="ln @line.Kind">@if (line.Tag is not null){<span class="tag t@(line.TagIndex)">@line.Tag</span>}@line.Text</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (tab == "flow")
                        {
                            var flows = FlowList;
                            var picked = flows.FirstOrDefault(f => f.TraceId == flowId) ?? flows.FirstOrDefault(f => !onlyProblems || f.Outcome != "ok");
                            @if (flowSession is null)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="flow" Size="22" /></span>
                                    <h3>See what a feature does, step by step</h3>
                                    <p>Run a .NET target, then use the app. Each request shows up here as a chain of steps — the request, calls to other services, database commands — with the data passed in and out, and any exception at the line that threw it.</p>
                                </div>
                            }
                            else if (flowSession.Flows is null)
                            {
                                <div class="state locked">
                                    <span class="glyph"><Icon Name="lock" Size="22" /></span>
                                    <h3>Recording is off for @flowSession.Env</h3>
                                    <p>Flows carry real request data, so they are never recorded for a protected environment or for non-.NET targets.</p>
                                </div>
                            }
                            else
                            {
                                <div class="scoreboard">
                                    <div class="score"><b>@flows.Count</b><span>flows</span></div>
                                    <div class="score ok"><b>@flows.Count(f => f.Outcome == "ok")</b><span>clean</span></div>
                                    <div class="score warn"><b>@flows.Count(f => f.Outcome == "warn")</b><span>with exceptions</span></div>
                                    <div class="score bad"><b>@flows.Count(f => f.Outcome == "failed")</b><span>failed</span></div>
                                    <div class="score"><b>@(flows.Count == 0 ? "–" : $"{flows.Max(f => f.Ms):0} ms")</b><span>slowest</span></div>
                                    <span class="spacer"></span>
                                    <div class="search narrow">
                                        <Icon Name="search" />
                                        <input class="input" placeholder="Filter, e.g. /api/claims" @bind="flowFilter" @bind:event="oninput" />
                                    </div>
                                    <label class="check"><input type="checkbox" @bind="onlyProblems" /> Problems only</label>
                                    <button class="btn small" @onclick="() => { flowSession.Flows.Clear(); flowId = null; }">Clear</button>
                                </div>

                                @if (flows.Count == 0)
                                {
                                    <div class="state">
                                        <span class="glyph"><Icon Name="flow" Size="22" /></span>
                                        <h3>@(flowSession.Running ? "Recording — nothing yet" : "Nothing was recorded")</h3>
                                        <p>Use the app in your browser. Requests appear here as they finish; exceptions appear the moment they are thrown.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="flow-split">
                                        <div class="flow-list">
                                            @foreach (var f in flows.Where(f => !onlyProblems || f.Outcome != "ok").Take(150))
                                            {
                                                <button class="flow-item @f.Outcome @(picked?.TraceId == f.TraceId ? "active" : "")" @onclick="() => { flowId = f.TraceId; openStep = null; }">
                                                    <span class="flow-mark"></span>
                                                    <span class="flow-text">
                                                        <span class="flow-title">@f.Title</span>
                                                        <span class="flow-meta">
                                                            @f.FirstSeen.ToLocalTime().ToString("HH:mm:ss")
                                                            @if (f.StatusCode is { } httpCode)
                                                            {
                                                                <span> · @httpCode</span>
                                                            }
                                                            <span> · @f.Ms.ToString("0") ms · @f.Steps.Count steps</span>
                                                            @if (f.Errors.Count > 0)
                                                            {
                                                                <span> · @f.Errors.Count exc</span>
                                                            }
                                                        </span>
                                                    </span>
                                                </button>
                                            }
                                        </div>

                                        <div class="flow-detail">
                                            @if (picked is null)
                                            {
                                                <div class="state"><p>No problems recorded. Untick "Problems only" to see every flow.</p></div>
                                            }
                                            else
                                            {
                                                <div class="flow-head">
                                                    <span class="badge @(picked.Outcome == "failed" ? "bad" : picked.Outcome == "warn" ? "warn" : "ok")">@(picked.Outcome == "failed" ? "Failed" : picked.Outcome == "warn" ? "Completed with exceptions" : "Clean")</span>
                                                    <h3>@picked.Title</h3>
                                                    <span class="flow-meta">@picked.Ms.ToString("0") ms · trace @picked.TraceId[..Math.Min(8, picked.TraceId.Length)]</span>
                                                </div>

                                                @foreach (var error in picked.Errors.Where(x => x.SpanId is null || !picked.Steps.ContainsKey(x.SpanId)))
                                                {
                                                    @ErrorCard(error)
                                                }

                                                <div class="track">
                                                    @foreach (var step in picked.Ordered())
                                                    {
                                                        var notes = picked.Notes.Where(n => n.SpanId == step.Id).ToList();
                                                        var errors = picked.Errors.Where(x => x.SpanId == step.Id).ToList();
                                                        var isOpen = openStep == step.Id;
                                                        var share = picked.Ms > 0 ? Math.Clamp(step.Ms / picked.Ms * 100, 1, 100) : 1;
                                                        <div class="phase @step.Category @(step.Failed ? "failed" : errors.Count > 0 ? "warn" : "") @(isOpen ? "open" : "")" style="--depth:@step.Depth">
                                                            <button class="phase-head" @onclick="() => openStep = isOpen ? null : step.Id">
                                                                <span class="phase-node"><Icon Name="@StepIcon(step)" Size="14" /></span>
                                                                <span class="phase-text">
                                                                    <span class="phase-kind">@StepKind(step)</span>
                                                                    <span class="phase-title">@step.Title</span>
                                                                </span>
                                                                @if (step.StatusCode is { } httpCode)
                                                                {
                                                                    <span class="badge @(httpCode >= 400 ? "bad" : "ok")">@httpCode</span>
                                                                }
                                                                @if (notes.Count > 0)
                                                                {
                                                                    <span class="badge accent">@notes.Count data</span>
                                                                }
                                                                @if (errors.Count > 0)
                                                                {
                                                                    <span class="badge @(errors.Any(x => x.Unhandled) ? "bad" : "warn")">@errors.Count exception@(errors.Count == 1 ? "" : "s")</span>
                                                                }
                                                                <span class="phase-ms">@step.Ms.ToString("0") ms</span>
                                                            </button>
                                                            <div class="phase-bar"><i style="width:@(share.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>

                                                            @foreach (var error in errors)
                                                            {
                                                                @ErrorCard(error)
                                                            }

                                                            @if (isOpen)
                                                            {
                                                                <div class="phase-body">
                                                                    @foreach (var note in notes)
                                                                    {
                                                                        <div class="capture">
                                                                            <div class="capture-head"><Icon Name="box" Size="13" /> @note.Label @if (note.Title is not null){<span class="flow-meta">@note.Title</span>}</div>
                                                                            <pre>@Pretty(note.Body)</pre>
                                                                        </div>
                                                                    }
                                                                    @if (step.StatusText is not null)
                                                                    {
                                                                        <div class="capture"><div class="capture-head">Status</div><pre>@step.StatusText</pre></div>
                                                                    }
                                                                    <table class="tags">
                                                                        <tr><td>source</td><td>@step.Source</td></tr>
                                                                        <tr><td>started</td><td>@step.Start.ToLocalTime().ToString("HH:mm:ss.fff")</td></tr>
                                                                        @foreach (var tag in step.Tags.OrderBy(t => t.Key))
                                                                        {
                                                                            <tr><td>@tag.Key</td><td>@tag.Value</td></tr>
                                                                        }
                                                                    </table>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else if (locked)
                        {
                            <div class="state locked">
                                <span class="glyph"><Icon Name="lock" Size="22" /></span>
                                <h3>@envName is protected</h3>
                                <p>Its values stay encrypted until you enter the passphrase. They then stay unlocked for @(VaultService.UnlockWindow.TotalMinutes.ToString("0")) minutes, in memory only.</p>
                                <button class="btn primary" @onclick="() => OpenUnlock(null)">
                                    <Icon Name="unlock" /> @(CurrentEnv.HasPassphrase ? $"Unlock {envName}" : "Set a passphrase")
                                </button>
                            </div>
                        }
                        else if (tab == "files")
                        {
                            @if (files.Count == 0)
                            {
                                <div class="state good">
                                    <span class="glyph"><Icon Name="shield" Size="22" /></span>
                                    <h3>No plaintext variable files</h3>
                                    <p>This repo has no .env files or launch profiles carrying variables. The vault is the only source.</p>
                                </div>
                            }
                            else
                            {
                                <div class="callout">
                                    <Icon Name="alert" />
                                    <div>These files hold variables in plain text. Import them into @envName, then delete the file so the vault is the only copy. An app that loads a .env at startup will prefer the file while it exists.</div>
                                </div>
                                @foreach (var f in files)
                                {
                                    <div class="file-row">
                                        <span class="file-glyph"><Icon Name="file" Size="18" /></span>
                                        <div class="file-body">
                                            <div class="file-name">@f.Relative</div>
                                            <div class="file-sub">
                                                @if (f.Profile is not null)
                                                {
                                                    <span>profile "@f.Profile" ·</span>
                                                }
                                                <span>@f.Pairs.Count variables</span>
                                                @if (f.InVault)
                                                {
                                                    <span class="badge ok"><Icon Name="check" Size="11" /> all in @envName</span>
                                                }
                                            </div>
                                        </div>
                                        @if (!f.InVault)
                                        {
                                            <button class="btn small" @onclick="() => ImportFile(f)"><Icon Name="download" Size="14" /> Import into @envName</button>
                                        }
                                        else if (f.Profile is null)
                                        {
                                            <button class="btn small @(confirmKey == "file:" + f.Path ? "confirm" : "stop")" @onclick="@(() => Confirm("file:" + f.Path, () => DeleteFile(f)))">
                                                <Icon Name="trash" Size="14" /> @(confirmKey == "file:" + f.Path ? "Click again to delete" : "Delete file")
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="toolbar">
                                <div class="search">
                                    <Icon Name="search" />
                                    <input class="input" placeholder="Filter variables" @bind="filter" @bind:event="oninput" />
                                </div>
                                <span class="spacer"></span>
                                <button class="btn small" @onclick="() => showPaste = !showPaste"><Icon Name="clipboard" Size="14" /> Paste .env</button>
                                <button class="btn primary small" @onclick="NewVariable"><Icon Name="plus" Size="14" /> Add variable</button>
                            </div>

                            @if (showPaste)
                            {
                                <div class="form-card">
                                    <label class="field">
                                        <span>Paste KEY=VALUE lines. They are stored encrypted for @envName and never written to a file.</span>
                                        <textarea class="input" rows="6" @bind="pasteText" placeholder="OpsApiBaseUrl=https://...&#10;ApiPassword=..."></textarea>
                                    </label>
                                    <div class="row">
                                        <button class="btn primary small" @onclick="ImportPaste">Import into @envName</button>
                                        <button class="btn small" @onclick="() => showPaste = false">Cancel</button>
                                    </div>
                                </div>
                            }

                            @if (editing)
                            {
                                <div class="form-card">
                                    <div class="grid2">
                                        <label class="field">
                                            <span>Name</span>
                                            <input class="input mono" @bind="formName" disabled="@formIsEdit" placeholder="OpsApiBaseUrl" />
                                        </label>
                                        <label class="field">
                                            <span>Value for @envName</span>
                                            <input class="input mono" type="@(formSecret ? "password" : "text")" @bind="formValue" autocomplete="off" />
                                        </label>
                                    </div>
                                    <label class="check"><input type="checkbox" @bind="formSecret" /> Secret — masked on screen and in output</label>
                                    <div class="row">
                                        <button class="btn primary small" @onclick="SaveVariable">Save</button>
                                        <button class="btn small" @onclick="() => editing = false">Cancel</button>
                                    </div>
                                </div>
                            }

                            @if (vars.Count == 0)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="key" Size="22" /></span>
                                    <h3>No variables for @envName yet</h3>
                                    <p>Add one, paste a .env block, or import a file from the Plaintext files tab.</p>
                                </div>
                            }
                            else
                            {
                                <table class="vars">
                                    <thead>
                                        <tr><th>Name</th><th>Value</th><th>Source</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in FilteredVars)
                                        {
                                            var own = v.Origin == "repo";
                                            var open = revealed.Contains(v.Name);
                                            <tr @key="v.Name">
                                                <td class="name">
                                                    <span class="name-cell">
                                                        @if (v.Secret)
                                                        {
                                                            <Icon Name="lock" Size="12" />
                                                        }
                                                        @v.Name
                                                    </span>
                                                </td>
                                                <td class="value @(v.Secret && !open ? "masked" : "")">@(v.Secret && !open ? "••••••••••" : v.Value)</td>
                                                <td><span class="badge">@v.Origin</span></td>
                                                <td class="tools">
                                                    @if (v.Secret)
                                                    {
                                                        <button class="icon-btn @(open ? "on" : "")" title="@(open ? "Hide value" : "Show value")" @onclick="() => ToggleReveal(v)"><Icon Name="@(open ? "eye-off" : "eye")" /></button>
                                                    }
                                                    @if (own)
                                                    {
                                                        <button class="icon-btn @(v.Secret ? "on" : "")" title="@(v.Secret ? "Secret: click to treat as a plain value" : "Plain value: click to mark as secret")" @onclick="() => ToggleSecret(v)"><Icon Name="@(v.Secret ? "lock" : "unlock")" /></button>
                                                        <button class="icon-btn" title="Edit" @onclick="() => EditVariable(v)"><Icon Name="pencil" /></button>
                                                        @if (confirmKey == "var:" + v.Name)
                                                        {
                                                            <button class="icon-btn sure" @onclick="@(() => Confirm("var:" + v.Name, () => DeleteVariable(v)))"><Icon Name="trash" Size="13" /> Delete?</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="icon-btn danger" title="Delete" @onclick="@(() => Confirm("var:" + v.Name, () => DeleteVariable(v)))"><Icon Name="trash" /></button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                </section>
            </div>
        }
    </main>
</div>

@if (message is not null)
{
    <div class="toast @(messageIsError ? "error" : "ok")" role="status">
        <Icon Name="@(messageIsError ? "alert" : "check")" />
        <span>@message</span>
        <button class="icon-btn" title="Dismiss" @onclick="() => message = null"><Icon Name="x" Size="14" /></button>
    </div>
}

@if (showUnlock)
{
    <div class="overlay">
        <div class="dialog">
            <span class="glyph"><Icon Name="lock" Size="20" /></span>
            <h2>@(CurrentEnv.HasPassphrase ? $"Unlock {envName}" : $"Set a passphrase for {envName}")</h2>
            <p>
                @(CurrentEnv.HasPassphrase
                    ? $"Stays unlocked for {VaultService.UnlockWindow.TotalMinutes:0} minutes, in memory only."
                    : "At least 8 characters. There is no recovery if it is forgotten.")
            </p>
            <input class="input" type="password" placeholder="Passphrase" @bind="passphrase" @bind:event="oninput" @onkeydown="UnlockOnEnter" autocomplete="off" />
            @if (!CurrentEnv.HasPassphrase)
            {
                <input class="input" type="password" placeholder="Repeat it" @bind="passphraseAgain" @bind:event="oninput" @onkeydown="UnlockOnEnter" autocomplete="off" />
            }
            @if (unlockError is not null)
            {
                <div class="error-text">@unlockError</div>
            }
            <div class="row end">
                <button class="btn" @onclick="CloseUnlock">Cancel</button>
                <button class="btn primary" @onclick="Unlock">@(CurrentEnv.HasPassphrase ? "Unlock" : "Set passphrase")</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record FileItem(string Path, string Relative, string? Profile, List<KeyValuePair<string, string>> Pairs, bool InVault);

    private List<RepoInfo> repos = [];
    private List<EnvInfo> envs = [];
    private List<TargetDef> targets = [];
    private List<Variable> vars = [];
    private List<FileItem> files = [];
    private List<RunSession> sessions = [];
    private List<string> unlocked = [];
    private List<string> folderSuggestions = [];
    private List<string> solutions = [];
    private HashSet<string> openInRider = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> counts = [];
    private readonly HashSet<string> revealed = new(StringComparer.OrdinalIgnoreCase);

    private RepoInfo? repo;
    private string envName = "LOCAL";
    private bool locked;
    private RunSession? shown;
    private ElementReference logElement;

    private sealed record LogLine(string? Tag, int TagIndex, string Text, string Kind);

    private string tab = "vars";
    private string? flowId;
    private string? openStep;
    private bool onlyProblems;
    private string flowFilter = "";
    private string filter = "";
    private bool hideWarnings = true;

    private string? message;
    private bool messageIsError;
    private DateTime messageAt;
    private string? confirmKey;

    private bool showAdd;
    private string addPath = "";
    private string addName = "";

    private bool editing, formIsEdit, formSecret;
    private string formName = "", formValue = "";

    private bool showPaste;
    private string pasteText = "";

    private bool showUnlock;
    private string passphrase = "", passphraseAgain = "";
    private string? unlockError;
    private Action? afterUnlock;

    private Timer? timer;
    private long seenVersion = -1;

    private EnvInfo CurrentEnv => envs.First(e => e.Name == envName);
    private List<RunSession> RepoSessions => repo is null ? [] : sessions.Where(s => s.Repo == repo.Name).ToList();

    protected override void OnInitialized()
    {
        Reload();
        // Output and elapsed times change without any click; refresh twice a second while something is happening.
        timer = new Timer(_ =>
        {
            var version = Sessions.Version;
            if (version == seenVersion && !sessions.Any(s => s.Running) && unlocked.Count == 0 && message is null) return;
            seenVersion = version;
            InvokeAsync(() =>
            {
                sessions = Sessions.All();
                if (message is not null && !messageIsError && DateTime.Now - messageAt > TimeSpan.FromSeconds(6)) message = null;
                var nowUnlocked = Vaults.UnlockedNames();
                if (nowUnlocked.Count != unlocked.Count) Reload(); // a protected environment just timed out
                StateHasChanged();
            });
        }, null, 500, 500);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (tab == "output" && shown is { Running: true }) await JS.InvokeVoidAsync("rrScrollEnd", logElement);
    }

    public void Dispose() => timer?.Dispose();

    // ---------- loading ----------

    private void Reload()
    {
        repos = Vaults.Use(v => v.Repos());
        envs = Vaults.Use(v => v.Environments());
        unlocked = Vaults.UnlockedNames();
        sessions = Sessions.All();
        repo = repo is null ? repos.FirstOrDefault() : repos.FirstOrDefault(r => r.Id == repo.Id) ?? repos.FirstOrDefault();
        LoadRepo();
    }

    private void LoadRepo()
    {
        vars = [];
        files = [];
        targets = [];
        counts = [];
        solutions = [];
        if (repo is null) return;

        if (!envs.Any(e => e.Name == envName)) envName = envs[0].Name;
        var current = repo;
        var env = CurrentEnv;
        targets = Vaults.Use(v => v.Targets(current));
        solutions = DebugSupport.Solutions(current).Select(f => System.IO.Path.GetRelativePath(current.Path, f)).ToList();
        var rider = DebugSupport.RiderRecentSolutions();
        openInRider = solutions.Where(f => rider.TryGetValue(System.IO.Path.Combine(current.Path, f), out var info) && info.Open)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        counts = envs.ToDictionary(e => e.Name, e => Vaults.Use(v => v.CountVars(Scope.Repo(current.Id), e)));
        locked = !Vaults.IsUnlocked(env);
        if (locked) return;

        vars = Vaults.Use(v =>
        {
            var resolved = v.Resolve(current, env);
            return resolved.Values.OrderBy(p => p.Key, StringComparer.OrdinalIgnoreCase)
                .Select(p => new Variable(p.Key, p.Value, resolved.SecretNames.Contains(p.Key), resolved.Origins[p.Key])).ToList();
        });
        files = FindFiles(current);
        if (shown is null || shown.Repo != current.Name) shown = RepoSessions.LastOrDefault();
    }

    private List<FileItem> FindFiles(RepoInfo current)
    {
        var own = vars.Where(v => v.Origin == "repo").ToDictionary(v => v.Name, v => v.Value, StringComparer.OrdinalIgnoreCase);
        bool InVault(List<KeyValuePair<string, string>> pairs) =>
            pairs.Count > 0 && pairs.All(p => own.TryGetValue(p.Key, out var value) && value == p.Value);

        var items = new List<FileItem>();
        foreach (var path in PlaintextFiles.Find(current.Path))
        {
            var relative = System.IO.Path.GetRelativePath(current.Path, path);
            try
            {
                if (System.IO.Path.GetFileName(path).Equals("launchSettings.json", StringComparison.OrdinalIgnoreCase))
                {
                    foreach (var profile in LaunchSettings.Read(path).Where(p => p.Variables.Count > 1))
                        items.Add(new FileItem(path, relative, profile.Name, profile.Variables, InVault(profile.Variables)));
                }
                else
                {
                    var pairs = DotEnv.Parse(File.ReadAllText(path));
                    if (pairs.Count > 0) items.Add(new FileItem(path, relative, null, pairs, InVault(pairs)));
                }
            }
            catch (Exception ex) when (ex is IOException or System.Text.Json.JsonException) { }
        }
        return items;
    }

    // ---------- small helpers ----------

    private void Say(string text, bool error = false) => (message, messageIsError, messageAt) = (text, error, DateTime.Now);

    private IEnumerable<Variable> FilteredVars => string.IsNullOrWhiteSpace(filter)
        ? vars
        : vars.Where(v => v.Name.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string Initials(string name)
    {
        var caps = new string(name.Where(char.IsUpper).Take(2).ToArray());
        return caps.Length == 2 ? caps : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private static int Hue(string name) => (int)(name.Aggregate(17u, (h, c) => h * 31 + c) % 360);

    private static string Tone(EnvInfo env) => env.Protected ? "red" : env.Name switch
    {
        "LOCAL" => "slate",
        "DEV" => "sky",
        "UAT" => "amber",
        "STAGING" => "violet",
        _ => "teal",
    };

    private string EnvTitle(EnvInfo env) =>
        env.Protected ? $"{env.Name}: protected by a passphrase" : $"{env.Name}: {counts.GetValueOrDefault(env.Name)} variables of this repo";

    private bool IsConfirming(TargetDef target, string mode) => confirmKey == $"run:{target.Name}:{mode}";

    // ---------- flow ----------

    /// <summary>The session whose flows are shown: the selected one if it records, else the newest that does.</summary>
    private RunSession? flowSession => shown is { Flows: not null } ? shown : RepoSessions.LastOrDefault(s => s.Flows is not null) ?? shown;

    private List<Flow> FlowList
    {
        get
        {
            var all = flowSession?.Flows?.Snapshot() ?? [];
            return string.IsNullOrWhiteSpace(flowFilter)
                ? all
                : all.Where(f => f.Title.Contains(flowFilter.Trim(), StringComparison.OrdinalIgnoreCase)
                              || f.Steps.Values.Any(s => s.Title.Contains(flowFilter.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    private static string StepIcon(FlowStep step) => step.Category switch
    {
        "request" => "download",
        "http" => "external",
        "db" => "database",
        _ => "dot",
    };

    private static string StepKind(FlowStep step) => step.Category switch
    {
        "request" => "Incoming request",
        "http" => "Call to another service",
        "db" => "Database",
        _ => step.Source.Length > 0 ? step.Source : "Step",
    };

    private static string Pretty(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
        }
        catch (System.Text.Json.JsonException) { return body; }
    }

    private void OpenFrame(FlowFrame frame) => Try(() =>
    {
        if (frame.File is null) return;
        DebugSupport.OpenInRider(flowSession?.Solution, frame.File, frame.Line);
        Say($"Opened {System.IO.Path.GetFileName(frame.File)}:{frame.Line} in Rider.");
    });

    private RenderFragment ErrorCard(FlowError error) => __builder =>
    {
        var origin = error.Origin;
        <div class="error-card @(error.Unhandled ? "unhandled" : "")">
            <div class="error-top">
                <Icon Name="alert" Size="15" />
                <span class="error-type">@error.Type.Split('.').Last()</span>
                <span class="badge @(error.Unhandled ? "bad" : "warn")">@(error.Unhandled ? "unhandled" : "thrown, then handled")</span>
                <span class="flow-meta">@error.At.ToLocalTime().ToString("HH:mm:ss.fff")</span>
            </div>
            <div class="error-message">@error.Message</div>
            @if (origin is not null)
            {
                <button class="frame origin" title="Open in Rider" @onclick="() => OpenFrame(origin)">
                    <Icon Name="pin" Size="13" />
                    <span class="mono">@System.IO.Path.GetFileName(origin.File):@origin.Line</span>
                    <span class="frame-method">@origin.Method</span>
                    <Icon Name="external" Size="12" />
                </button>
            }
            @if (error.Frames.Count > 1)
            {
                <details>
                    <summary>Call stack · @error.Frames.Count frames</summary>
                    @foreach (var frame in error.Frames)
                    {
                        @if (frame.File is not null)
                        {
                            <button class="frame" title="Open in Rider" @onclick="() => OpenFrame(frame)">
                                <span class="mono">@System.IO.Path.GetFileName(frame.File):@frame.Line</span>
                                <span class="frame-method">@frame.Method</span>
                            </button>
                        }
                        else
                        {
                            <div class="frame dim"><span class="frame-method">@frame.Method</span></div>
                        }
                    }
                </details>
            }
        </div>
    };

    /// <summary>The visible lines of the selected session, classified for colour, plus how many warnings were hidden.</summary>
    private (List<LogLine> Lines, int Hidden) LogView()
    {
        var lines = new List<LogLine>();
        var tags = new List<string>();
        var hidden = 0;
        foreach (var raw in shown?.Lines() ?? [])
        {
            string? tag = null;
            var text = raw;
            var close = raw.IndexOf("] ", StringComparison.Ordinal);
            if (raw.StartsWith('[') && close is > 1 and < 32 && !raw.StartsWith("[rr-debug]"))
            {
                tag = raw[1..close].Trim();
                text = raw[(close + 2)..];
                if (!tags.Contains(tag)) tags.Add(tag);
            }
            var kind =
                text.Contains(": warning ") ? "warn"
                : text.Contains(": error ") || text.Contains("Unhandled exception") || text.Contains(" ERR]") || text.StartsWith("fail:") || text.StartsWith("Failed:") ? "err"
                : text.Contains("Now listening on") || text.Contains("started successfully") || text.Contains("debugger attached") ? "ok"
                : tag is null ? "sys" : "";
            if (kind == "warn" && hideWarnings) { hidden++; continue; }
            lines.Add(new LogLine(tag, tag is null ? 0 : tags.IndexOf(tag) % 4, text, kind));
        }
        return (lines, hidden);
    }

    private void Try(Action work)
    {
        try { work(); }
        catch (VaultException ex) { Say(ex.Message, error: true); }
    }

    private void Confirm(string key, Action action)
    {
        if (confirmKey != key) { confirmKey = key; return; }
        confirmKey = null;
        action();
    }

    private static string Elapsed(RunSession s)
    {
        var span = (s.Ended ?? DateTime.Now) - s.Started;
        return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss");
    }

    private string RunLabel(TargetDef target, string mode) =>
        confirmKey == $"run:{target.Name}:{mode}" ? $"Click again to {mode.ToLowerInvariant()} on {envName}" : mode;

    // ---------- repos and environments ----------

    private void SelectRepo(RepoInfo selected)
    {
        repo = selected;
        if (selected.DefaultEnv is { } preferred && envs.Any(e => e.Name == preferred)) envName = preferred;
        revealed.Clear();
        editing = showPaste = false;
        confirmKey = null;
        shown = null;
        filter = "";
        LoadRepo();
        tab = RepoSessions.Any(s => s.Running) ? "output" : "vars";
    }

    private void SelectEnv(string name)
    {
        envName = name;
        revealed.Clear();
        editing = showPaste = false;
        confirmKey = null;
        var current = repo!;
        Vaults.Use(v => v.SetRepoDefaults(current, null, name)); // reopen on the environment last used
        Reload();
    }

    private void OpenAdd()
    {
        showAdd = true;
        addPath = addName = "";
        var known = repos.Select(r => r.Path).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var roots = repos.Select(r => System.IO.Path.GetDirectoryName(r.Path))
            .Append(System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "source", "repos"))
            .Where(d => d is not null && Directory.Exists(d)).Distinct(StringComparer.OrdinalIgnoreCase);
        folderSuggestions = roots.SelectMany(d => Directory.GetDirectories(d!)).Where(d => !known.Contains(d))
            .OrderBy(d => d, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void AddRepo() => Try(() =>
    {
        if (string.IsNullOrWhiteSpace(addPath)) throw new VaultException("Enter the repo's folder.");
        var added = Vaults.Use(v =>
        {
            var created = v.AddRepo(addPath.Trim().Trim('"'), string.IsNullOrWhiteSpace(addName) ? null : addName.Trim());
            var detected = Detector.Detect(created.Path);
            foreach (var target in detected.Targets) v.SaveTarget(created, target);
            v.SetRepoDefaults(created, detected.DefaultTarget, null);
            v.Audit("add", created.Name);
            return (Repo: v.GetRepo(created.Name), Count: detected.Targets.Count);
        });
        showAdd = false;
        repo = added.Repo;
        shown = null;
        Reload();
        Say($"Added {added.Repo.Name} with {added.Count} run target(s).");
    });

    // ---------- running ----------

    private void Run(TargetDef target, string mode)
    {
        var env = CurrentEnv;
        if (!Vaults.IsUnlocked(env)) { OpenUnlock(() => Run(target, mode)); return; }
        var key = $"run:{target.Name}:{mode}";
        if (env.Protected && confirmKey != key) { confirmKey = key; return; }
        confirmKey = null;
        Try(() =>
        {
            shown = Sessions.Start(Vaults, repo!, env, target, watch: mode == "Watch", debug: mode == "Debug");
            tab = "output";
            sessions = Sessions.All();
        });
    }

    private void StopSession(RunSession session) => Sessions.Stop(session);

    private string SolutionOf(TargetDef target) =>
        DebugSupport.FindSolution(repo!, target) is { } full ? System.IO.Path.GetRelativePath(repo!.Path, full) : "";

    private void SetSolution(TargetDef target, string? relative) => Try(() =>
    {
        if (string.IsNullOrEmpty(relative)) return;
        var current = repo!;
        target.Solution = relative;
        Vaults.Use(v => v.SaveTarget(current, target));
        Say($"{target.Name} will be debugged with {relative}.");
    });

    private void Dismiss(RunSession session)
    {
        Sessions.Dismiss(session);
        sessions = Sessions.All();
        shown = RepoSessions.LastOrDefault();
    }

    private void Quit() => Lifetime.StopApplication();

    // ---------- variables ----------

    private void NewVariable()
    {
        (editing, formIsEdit, formName, formValue, formSecret) = (true, false, "", "", false);
        tab = "vars";
    }

    private void EditVariable(Variable v)
    {
        (editing, formIsEdit, formName, formValue, formSecret) = (true, true, v.Name, v.Value, v.Secret);
    }

    private void SaveVariable() => Try(() =>
    {
        if (string.IsNullOrWhiteSpace(formName)) throw new VaultException("Give the variable a name.");
        var (current, env, name, value, secret) = (repo!, CurrentEnv, formName.Trim(), formValue, formSecret);
        Vaults.Use(v =>
        {
            v.SetVar(Scope.Repo(current.Id), env, name, value, secret);
            v.Audit("set", current.Name, env.Name, name);
        });
        editing = false;
        Reload();
        Say($"Saved {name} for {env.Name}.");
    });

    private void DeleteVariable(Variable variable) => Try(() =>
    {
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v =>
        {
            v.RemoveVar(Scope.Repo(current.Id), env, variable.Name);
            v.Audit("unset", current.Name, env.Name, variable.Name);
        });
        Reload();
    });

    private void ToggleSecret(Variable variable) => Try(() =>
    {
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v => v.SetSecret(Scope.Repo(current.Id), env, variable.Name, !variable.Secret));
        revealed.Remove(variable.Name);
        Reload();
    });

    private void ToggleReveal(Variable variable)
    {
        if (!revealed.Add(variable.Name)) { revealed.Remove(variable.Name); return; }
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v => v.Audit("reveal", current.Name, env.Name, variable.Name));
    }

    private int Store(List<KeyValuePair<string, string>> pairs, string source)
    {
        var (current, env) = (repo!, CurrentEnv);
        return Vaults.Use(v =>
        {
            foreach (var (name, value) in pairs) v.SetVar(Scope.Repo(current.Id), env, name, value);
            var stored = v.ListVars(Scope.Repo(current.Id), env, "repo").ToDictionary(x => x.Name, x => x.Value, StringComparer.OrdinalIgnoreCase);
            var bad = pairs.Where(p => !stored.TryGetValue(p.Key, out var value) || value != pairs.Last(q => q.Key.Equals(p.Key, StringComparison.OrdinalIgnoreCase)).Value)
                .Select(p => p.Key).Distinct().ToList();
            if (bad.Count > 0) throw new VaultException($"Could not verify: {string.Join(", ", bad)}.");
            v.Audit("import", current.Name, env.Name, $"{pairs.Count} from {source}");
            return pairs.Select(p => p.Key).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        });
    }

    private void ImportPaste() => Try(() =>
    {
        var pairs = DotEnv.Parse(pasteText);
        if (pairs.Count == 0) throw new VaultException("No KEY=VALUE lines found in the pasted text.");
        var count = Store(pairs, "pasted text");
        pasteText = "";
        showPaste = false;
        Reload();
        Say($"Imported and verified {count} variables into {envName}.");
    });

    private void ImportFile(FileItem file) => Try(() =>
    {
        var count = Store(file.Pairs, System.IO.Path.GetFileName(file.Path));
        Reload();
        Say($"Imported and verified {count} variables from {file.Relative} into {envName}. The file is still on disk.");
    });

    private void DeleteFile(FileItem file) => Try(() =>
    {
        // Offered only when every value in the file matches what the vault holds for this environment.
        if (!file.InVault) throw new VaultException("That file has values the vault does not hold yet. Import it first.");
        try { File.Delete(file.Path); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { throw new VaultException($"Could not delete the file: {ex.Message}"); }
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v => v.Audit("delete-source", current.Name, env.Name, file.Relative));
        Reload();
        Say($"Deleted {file.Relative}. {current.Name} now gets these values only from the vault.");
    });

    // ---------- protected environments ----------

    private void OpenUnlock(Action? then)
    {
        (showUnlock, passphrase, passphraseAgain, unlockError, afterUnlock) = (true, "", "", null, then);
    }

    private void CloseUnlock()
    {
        (showUnlock, passphrase, passphraseAgain, afterUnlock) = (false, "", "", null);
    }

    private void UnlockOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Unlock();
    }

    private void Unlock()
    {
        var env = CurrentEnv;
        if (!env.HasPassphrase && passphrase != passphraseAgain) { unlockError = "The two entries differ."; return; }
        try { Vaults.Unlock(env, passphrase); }
        catch (VaultException ex) { unlockError = ex.Message; return; }
        var then = afterUnlock;
        CloseUnlock();
        Reload();
        then?.Invoke();
    }

    private void LockAll()
    {
        Vaults.LockAll();
        revealed.Clear();
        Reload();
    }
}
