    private static bool IsRequest(Flow flow) => FlowRules.IsRequest(flow);

    private const string BlazorHub = FlowRules.BlazorHub;

    private static bool IsChatter(Flow flow) => FlowRules.IsChatter(flow);

    private List<Flow> FlowsInView()
    {
        IEnumerable<Flow> flows = AllFlows.Where(f => !IsChatter(f));
        if (featureFilter is { } feature) flows = flows.Where(f => FeatureOf(f) == feature);
        if (!string.IsNullOrWhiteSpace(flowFilter))
        {
            var text = flowFilter.Trim();
            flows = flows.Where(f => f.Title.Contains(text, StringComparison.OrdinalIgnoreCase)
                                  || f.Steps.Values.Any(s => s.Title.Contains(text, StringComparison.OrdinalIgnoreCase))
                                  || f.Errors.Any(e => e.Type.Contains(text, StringComparison.OrdinalIgnoreCase)));
        }
        return flows.ToList();
    }

    private static (string? Verb, string Label, string? Host) Describe(FlowStep step)
    {
        var verb = step.Tag("http.request.method", "http.method");
        if (step.Category == "request") return (verb, step.Tag("url.path", "http.target", "http.route") ?? step.Name, null);
        if (step.Category == "http" && Uri.TryCreate(step.Tag("url.full", "http.url"), UriKind.Absolute, out var uri))
            return (verb, uri.AbsolutePath, uri.Authority);
        var name = step.Title.Length > 0 ? step.Title : step.Name;
        // Blazor names its own activity "Event onclick -> Namespace.Component.Handler" and "Route /path -> Component".
        if (name.StartsWith("Event ") && name[6..].Split(" -> ", 2) is [var trigger, var handler])
        {
            var parts = handler.Split('.');
            var component = parts.Length > 1 ? parts[^2] : handler;
            // An inline lambda has a compiler-made name; the component alone says more.
            var label = parts[^1].StartsWith('<') ? component : $"{component}.{parts[^1]}";
            return ((trigger.StartsWith("on") ? trigger[2..] : trigger).ToUpperInvariant(), label, null);
        }
        if (name.StartsWith("Route ") && name[6..].Split(" -> ", 2) is [var route, _]) return ("NAV", route, null);
        if (name.StartsWith("Circuit ")) return (null, "Blazor circuit opened", null);
        if (name.StartsWith(BlazorHub))
            return ("UI", name[BlazorHub.Length..] switch
            {
                "UpdateRootComponents" or "StartCircuit" => "page renders",
                "OnRenderCompleted" => "after render",
                "BeginInvokeDotNetFromJS" => "browser calls into the page",
                "EndInvokeJSFromDotNet" => "browser replies to the page",
                "OnLocationChanged" => "address changes",
                var other => other,
            }, null);
        return (null, name, null);
    }

    private static (string? Verb, string Label, string? Host) Describe(Flow flow) =>
        flow.Root is { } root ? Describe(root)
        : (null, flow.Errors.Count > 0 ? flow.Errors[0].Type.Split('.').Last() : flow.Title, null);

    /// <summary>Which device a step talks to: a host for an outgoing call, a server or database name for a query.</summary>
    private static string? DeviceOf(FlowStep step) => step.Category switch
    {
        "http" => Uri.TryCreate(step.Tag("url.full", "http.url"), UriKind.Absolute, out var uri) ? uri.Authority.ToLowerInvariant() : null,
        "db" => "db:" + (step.Tag("server.address", "net.peer.name", "db.name", "db.namespace", "db.system", "db.system.name") ?? "database").ToLowerInvariant(),
        _ => null,
    };

    /// <summary>Rows for the list. Identical trouble-free background calls (a log shipper, a health ping) collapse into one.</summary>
    private List<FlowRow> FlowRows(List<Flow> flows)
    {
        var rows = new List<FlowRow>();
        var groups = new Dictionary<string, int>();
        foreach (var flow in flows)
        {
            var visible = flowView switch
            {
                "requests" => IsRequest(flow),
                "background" => !IsRequest(flow),
                "problems" => flow.Outcome != "ok",
                _ => true,
            };
            if (!visible) continue;
            var (verb, label, host) = Describe(flow);
            if (!IsRequest(flow) && flow.Outcome == "ok")
            {
                var key = $"{verb} {host}{label}";
                if (groups.TryGetValue(key, out var at)) { rows[at] = rows[at] with { Count = rows[at].Count + 1 }; continue; }
                groups[key] = rows.Count;
            }
            rows.Add(new FlowRow(flow, 1, verb, label, host));
        }
        return rows;
    }

    private static string Short(string text, int max) => text.Length <= max ? text : text[..(max - 1)] + "…";

    /// <summary>OpsApiBaseUrl → OpsApi, OPEN_SEARCH_URI → OPEN_SEARCH: the device a variable points at.</summary>
    private static string Friendly(string variable)
    {
        foreach (var suffix in new[] { "BaseUrl", "_URL", "_URI", "Url", "Uri" })
            if (variable.Length > suffix.Length && variable.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
                return variable[..^suffix.Length].TrimEnd('_');
        return variable;
    }

    /// <summary>
    /// The devices and links: whoever calls the app, the app, and everything it depends on. Dependencies come from
    /// two places: addresses the vault holds for this environment, and addresses the app was seen calling.
    /// </summary>
    private FlowMap BuildMap(List<Flow> flows)
    {
        var known = new Dictionary<string, Dependency>();
        foreach (var variable in vars.Where(v => !v.Secret))
        {
            if (!Uri.TryCreate(variable.Value.Trim().Trim('"'), UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https")) continue;
            var key = uri.Authority.ToLowerInvariant();
            if (!known.TryGetValue(key, out var dependency))
                known[key] = dependency = new Dependency { Name = Friendly(variable.Name), Kind = "service", Address = uri.Authority };
            dependency.Variables.Add(variable.Name);
        }
        foreach (var step in flows.SelectMany(f => f.Steps.Values))
        {
            if (DeviceOf(step) is not { } key) continue;
            if (!known.TryGetValue(key, out var dependency))
            {
                var isDb = step.Category == "db";
                known[key] = dependency = new Dependency
                {
                    Name = isDb ? step.Tag("db.name", "db.namespace", "db.system", "db.system.name") ?? "Database" : key.Split(':')[0],
                    Kind = isDb ? "db" : "service",
                    Address = isDb ? key[3..] : key,
                };
            }
            dependency.Calls++;
            if (step.Failed) dependency.Failed++;
            if (step.Start > dependency.Last) dependency.Last = step.Start;
        }

        // Everything that carried traffic is drawn; configured-but-unused devices fill the map up to seven.
        var used = known.Count(d => d.Value.Calls > 0);
        var shownDeps = known.OrderByDescending(d => d.Value.Calls).ThenBy(d => d.Value.Name, StringComparer.OrdinalIgnoreCase)
            .Take(Math.Clamp(used, 7, 10)).ToList();
        var height = Math.Max(360, shownDeps.Count * 76 + 40);
        var mid = height / 2.0;
        var live = flowSession?.Running == true;
        bool Recent(DateTime when) => live && (DateTime.UtcNow - when).TotalSeconds < 2.5;

        var requests = flows.Where(IsRequest).ToList();
        var failedRequests = requests.Count(f => f.Outcome == "failed");
        var exceptions = flows.Sum(f => f.Errors.Count);
        var appName = repo!.Name;

        var nodes = new List<MapNode>
        {
            new("client", "client", "Caller", "Whoever calls the app", "browser, client", "monitor", 16, mid - 30, 140, 60,
                requests.Count == 0 ? "idle" : failedRequests > 0 ? "failed" : "active",
                requests.Count == 0 ? null : $"{requests.Count} in", null, [], requests.Count, failedRequests),
            new("app", "app", Short(appName, 13), appName, Short(flowSession?.Target ?? "", 15), "server", 236, mid - 40, 176, 80,
                flows.Any(f => f.Outcome == "failed") ? "failed" : "active",
                exceptions == 0 ? null : $"{exceptions} exc", flowSession?.Url, [], requests.Count, failedRequests),
        };
        var edges = new List<MapEdge>
        {
            new("client", $"M156 {N(mid)} L236 {N(mid)}",
                requests.Count == 0 ? "idle" : failedRequests > 0 ? "failed" : requests.Any(f => Recent(f.FirstSeen)) ? "active live" : "active"),
        };

        var top = (height - (shownDeps.Count * 76 - 18)) / 2.0;
        for (var i = 0; i < shownDeps.Count; i++)
        {
            var (key, dependency) = shownDeps[i];
            var y = top + i * 76;
            var state = dependency.Calls == 0 ? "idle" : dependency.Failed > 0 ? "failed" : "active";
            nodes.Add(new MapNode(key, dependency.Kind, Short(dependency.Name, 13), dependency.Name, Short(dependency.Address, 17),
                dependency.Kind == "db" ? "database" : "globe", 568, y, 184, 60, state,
                dependency.Calls == 0 ? null : dependency.Failed > 0 ? $"{dependency.Failed}/{dependency.Calls} failed" : $"{dependency.Calls}",
                dependency.Address, dependency.Variables, dependency.Calls, dependency.Failed));
            edges.Add(new MapEdge(key, $"M412 {N(mid)} C492 {N(mid)} 488 {N(y + 30)} 568 {N(y + 30)}",
                state + (Recent(dependency.Last) ? " live" : "")));
        }
        return new FlowMap(nodes, edges, height);
    }

    /// <summary>A flow as an ordered list of hops, each tied to the link its message travels on.</summary>
    private List<FlowEvent> EventsOf(Flow flow, FlowMap map)
    {
        var app = repo!.Name;
        string? PathOf(string key) => map.Edges.FirstOrDefault(e => e.Key == key)?.Path;
        var notes = flow.Notes.ToLookup(n => n.SpanId ?? "");
        var events = new List<FlowEvent>();

        foreach (var step in flow.Ordered())
        {
            var (verb, label, host) = Describe(step);
            var title = verb is null ? label : $"{verb} {label}";
            var captured = notes[step.Id].ToList();
            switch (step.Category)
            {
                case "request":
                    events.Add(new FlowEvent($"Caller → {app}", title, "app", "client", PathOf("client"), "go", false, null, null, step, null, captured, step.Start));
                    break;
                case "http" or "db":
                {
                    var node = map.Nodes.FirstOrDefault(n => n.Key == DeviceOf(step));
                    events.Add(new FlowEvent($"{app} → {node?.FullName ?? host ?? "a dependency"}", title, node?.Key ?? "app", node?.Key,
                        node is null ? null : PathOf(node.Key), "round", step.Failed, step.StatusCode, step.Ms, step, null, captured, step.Start,
                        flow.Stacks.GetValueOrDefault(step.Id)));
                    break;
                }
                default:
                    events.Add(new FlowEvent($"Inside {app}", title, "app", null, null, "pulse", step.Failed, null, step.Ms, step, null, captured, step.Start));
                    break;
            }
        }
        foreach (var error in flow.Errors)
            events.Add(new FlowEvent($"Inside {app}", $"{error.Type.Split('.').Last()} thrown", "app", null, null, "pulse", error.Unhandled,
                null, null, null, error, [], error.At));
        foreach (var loose in flow.Notes.Where(n => n.SpanId is null || !flow.Steps.ContainsKey(n.SpanId)))
            events.Add(new FlowEvent($"Inside {app}", loose.Title ?? loose.Label, "app", null, null, "pulse", false, null, null, null, null, [loose], loose.At));

        events = events.OrderBy(e => e.At).ToList();
        if (flow.Root is { Category: "request" } root)
            events.Add(new FlowEvent($"{app} → Caller", $"Response{(root.StatusCode is { } code ? $" {code}" : "")}", "client", "client", PathOf("client"),
                "back", root.Failed, root.StatusCode, root.Ms, null, null, [], root.Start.AddMilliseconds(root.Ms)));
        return events;
    }

    /// <summary>Recent traffic of one device: requests for the app and its caller, calls for a dependency.</summary>
    private List<Call> CallsTo(List<Flow> flows, string key)
    {
        if (key is "app" or "client")
            return flows.Where(IsRequest).Select(f =>
            {
                var (verb, label, _) = Describe(f);
                return new Call(f, f.Root!, verb, label, f.Ms, f.Outcome == "failed");
            }).ToList();
        return flows.SelectMany(f => f.Steps.Values.Where(s => DeviceOf(s) == key).Select(s =>
        {
            var (verb, label, _) = Describe(s);
            return new Call(f, s, verb, label, s.Ms, s.Failed);
        })).OrderByDescending(c => c.Step.Start).ToList();
    }

    /// <summary>Things worth knowing that reading the code would not show.</summary>
    private List<Notice> Insights(List<Flow> flows, FlowMap map)
    {
        var notices = new List<Notice>();
        foreach (var node in map.Nodes.Where(n => n.Kind is "service" or "db" && n.Failed > 0))
            notices.Add(new Notice("bad", $"{node.FullName} is failing: {node.Failed} of {node.Calls} calls.", () => PickNode(node.Key)));

        var swallowed = flows.Where(f => f.Errors.Any(e => !e.Unhandled)).ToList();
        if (swallowed.Count > 0)
        {
            var count = swallowed.Sum(f => f.Errors.Count(e => !e.Unhandled));
            var first = swallowed[^1].Errors.First(e => !e.Unhandled);
            var where = first.Origin is { File: not null } origin ? $" at {System.IO.Path.GetFileName(origin.File)}:{origin.Line}" : "";
            notices.Add(new Notice("warn", $"{count} exception{(count == 1 ? " was" : "s were")} thrown and quietly handled. First: {first.Type.Split('.').Last()}{where}.",
                () => OpenFlow(swallowed[^1].TraceId, null)));
        }

        foreach (var node in map.Nodes.Where(n => n.Kind == "service" && n.Calls > 0 && n.Variables.Count == 0).Take(2))
            notices.Add(new Notice("warn", $"The app calls {node.Address}, which no variable in {envName} sets.", () => PickNode(node.Key)));

        var missing = MissingReads;
        if (missing.Count > 0)
            notices.Add(new Notice("warn", $"The code reads {missing.Count} variable{(missing.Count == 1 ? "" : "s")} that {envName} does not define: {string.Join(", ", missing.Take(4).Select(r => r.Name))}{(missing.Count > 4 ? "…" : "")}.",
                () => tab = "vars"));

        foreach (var flow in flows.Where(IsRequest))
        {
            var repeated = flow.Steps.Values.Where(s => s.Category is "http" or "db").GroupBy(s => s.Title).FirstOrDefault(g => g.Count() >= 4);
            if (repeated is null) continue;
            notices.Add(new Notice("warn", $"One request made the same call {repeated.Count()} times: {Short(repeated.Key, 60)}.", () => OpenFlow(flow.TraceId, null)));
            break;
        }
        return notices.Take(5).ToList();
    }

    /// <summary>Variables the code reads by name that neither this environment nor Windows provides.</summary>
    private List<EnvRead> MissingReads => scan is null || locked
        ? []
        : scan.EnvReads.Where(r => !vars.Any(v => v.Name.Equals(r.Name, StringComparison.OrdinalIgnoreCase))
                                && Environment.GetEnvironmentVariable(r.Name) is null
                                && r.Name is not ("ASPNETCORE_ENVIRONMENT" or "DOTNET_ENVIRONMENT" or "ASPNETCORE_URLS")).ToList();

    // ---------- flow: actions ----------

    private void PickNode(string key)
    {
        selectedNode = selectedNode == key ? null : key;
        flowId = null;
        playing = false;
    }

    private void OpenFlow(string traceId, string? stepId)
    {
        flowId = traceId;
        selectedNode = null;
        playing = false;
        eventIndex = 0;
        if (stepId is not null && AllFlows.FirstOrDefault(f => f.TraceId == traceId) is { } flow)
            eventIndex = Math.Max(0, EventsOf(flow, BuildMap(FlowsInView())).FindIndex(e => e.Step?.Id == stepId));
        packetKey++;
        tab = "flow";
    }

    private void CloseFlow()
    {
        flowId = null;
        playing = false;
    }

    private void GoTo(int index)
    {
        eventIndex = index;
        packetKey++;
        playing = false;
    }

    private void Step(int delta, int count) => GoTo(Math.Clamp(eventIndex + delta, 0, Math.Max(0, count - 1)));

    private void TogglePlay(int count)
    {
        if (playing) { playing = false; return; }
        if (eventIndex >= count - 1) eventIndex = 0;
        packetKey++;
        playCount = count;
        playing = true;
        playTimer ??= new Timer(_ => InvokeAsync(() =>
        {
            if (!playing) return;
            if (eventIndex < playCount - 1) { eventIndex++; packetKey++; }
            else playing = false;
            StateHasChanged();
        }), null, 1300, 1300);
    }

    private void ClearFlows()
    {
        flowSession?.Flows?.Clear();
        flowId = null;
        selectedNode = null;
        featureOfFlow.Clear();
    }

    // ---------- processes: record, view across systems, replay ----------

    private List<SavedProcess> saved = [];
    private long savedRepoId = -1;
    private string? procId;
    private string procName = "";
    private DateTime? recordingSince;
    private string recordingName = "";
    private bool showBackground;

    private static string Pct(double fraction) => (fraction * 100).ToString("0.###", Plain) + "%";

    private static string Size(string? text) => text is null ? "" : text.Length < 1024 ? $"{text.Length} B" : $"{text.Length / 1024.0:0.#} KB";

    /// <summary>A step someone took: a page request, a click, a navigation. Everything else is background.</summary>
    private static bool IsStage(Flow flow) => FlowRules.IsStage(flow);

    private long seenKept = -1;

    /// <summary>Picks up failures kept since the page last looked, and says so when they belong to this repo.</summary>
    private void NoticeKept()
    {
        var version = Keeper.Version;
        if (version == seenKept) return;
        var first = seenKept < 0;
        seenKept = version;
        if (first || repo is null) return;
        savedRepoId = -1;
        var open = procId;
        LoadSaved();
        procId = open;
        if (Keeper.Last is { } last && last.Repo == repo.Name) Say($"Kept a failure: {last.Reason}.", error: true);
    }

    private void LoadSaved()
    {
        if (repo is null || repo.Id == savedRepoId) return;
        savedRepoId = repo.Id;
        var current = repo;
        try { saved = Recordings.List(current); }
        catch (VaultException) { saved = []; }
        procId = null;
    }

    /// <summary>The flows on show: a saved process, or the current run (from the moment recording began, while recording).</summary>
    private List<Flow> ProcessFlows(SavedProcess? opened)
    {
        IEnumerable<Flow> flows = opened?.Flows.Where(f => f.App is null || f.App == opened.Flows[0].App || f.App == repo?.Name)
            ?? FlowRules.WithRounds(AllFlows.Where(f => !IsChatter(f) && (recordingSince is null || f.FirstSeen >= recordingSince)));
        if (!showBackground) flows = flows.Where(IsStage);
        var ordered = flows.OrderBy(f => f.FirstSeen).ToList();
        if (showBackground) return ordered;

        var kept = new List<Flow>();
        foreach (var flow in ordered)
        {
            var bare = flow.Steps.Count == 1 && flow.Errors.Count == 0 && flow.Root is { } root && root.Name.StartsWith("Route ");
            if (bare)
            {
                var path = Describe(flow).Label;
                var echoed = ordered.Any(other => !ReferenceEquals(other, flow) && Describe(other).Label == path
                    && Math.Abs((other.FirstSeen - flow.FirstSeen).TotalSeconds) < 3
                    && (IsRequest(other) || kept.Contains(other)));
                if (echoed) continue;
            }
            kept.Add(flow);
        }
        return kept;
    }

    private static readonly string[] IntentFields =
        ["targetCommand", "command", "commandName", "operation", "operationName", "action", "procedure", "storedProcedure", "queryName", "method"];

    /// <summary>
    /// Many systems send every call to one generic endpoint and say what they want in the body. When the request
    /// names its command, that name describes the call better than the address does.
    /// </summary>
    private static string? Intent(string? requestBody)
    {
        if (requestBody is null || requestBody.Length > 200_000 || !requestBody.TrimStart().StartsWith('{')) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(requestBody);
            foreach (var property in doc.RootElement.EnumerateObject())
                if (property.Value.ValueKind == System.Text.Json.JsonValueKind.String
                    && IntentFields.Contains(property.Name, StringComparer.OrdinalIgnoreCase)
                    && property.Value.GetString() is { Length: > 0 and < 80 } name)
                    return name;
        }
        catch (System.Text.Json.JsonException) { }
        return null;
    }

    private void OpenProcess(string? id)
    {
        procId = id;
        (openCall, allSteps, procSystem, procProblemsOnly, procFilter) = (null, null, null, false, "");
        (compareId, openDiff) = (null, null);
        (recheckShown, editingCall, editor) = (false, null, null);
        toggledSteps.Clear();
    }

    private void StartRecording()
    {
        if (string.IsNullOrWhiteSpace(procName)) { Say("Give the process a name first.", error: true); return; }
        (recordingName, recordingSince, procId) = (procName.Trim(), DateTime.UtcNow, null);
    }

    private void StopRecording() => SaveProcess(recordingName, recordingSince ?? DateTime.MinValue);

    private void SaveCaptured()
    {
        if (string.IsNullOrWhiteSpace(procName)) { Say("Give the process a name first.", error: true); return; }
        SaveProcess(procName.Trim(), DateTime.MinValue);
    }

    private void SaveProcess(string name, DateTime since) => Try(() =>
    {
        var flows = FlowRules.WithRounds(AllFlows.Where(f => f.FirstSeen >= since && !IsChatter(f))).Where(IsStage).OrderBy(f => f.FirstSeen).ToList();
        if (flows.Count == 0) throw new VaultException("Nothing was captured in that time. Use the app while recording.");
        var current = repo!;
        // What your other sandboxed apps did while handling these calls goes with the recording.
        var traces = flows.Select(f => f.TraceId).ToHashSet();
        flows.AddRange(Sessions.All().Where(s => s.Repo != current.Name && s.Flows is not null)
            .SelectMany(s => s.Flows!.Snapshot()).Where(f => traces.Contains(f.TraceId)));
        var process = Recordings.Save(current, name, envName, flows);
        saved.Insert(0, process);
        (recordingSince, procName, procId) = (null, "", process.Id);
        var bodies = flows.Sum(f => f.Bodies.Count);
        Say($"Saved “{name}”: {flows.Count} steps, {bodies} calls with their data.");
    });

    private void DeleteProcess(SavedProcess process) => Try(() =>
    {
        Recordings.Delete(repo!, process);
        saved.Remove(process);
        procId = null;
    });

    /// <summary>Starts the app in the sandbox, answering first from this recording.</summary>
    private async Task RunAgainst(SavedProcess process)
    {
        var target = targets.FirstOrDefault(t => t.Kind == "dotnet" && t.Name.Equals(repo!.DefaultTarget, StringComparison.OrdinalIgnoreCase))
            ?? targets.FirstOrDefault(t => t.Kind == "dotnet");
        if (target is null) { Say("This repo has no .NET app to run.", error: true); return; }
        if (sessions.Any(s => s.Running && s.Repo == repo!.Name && s.Target == target.Name))
        {
            Say($"{target.Name} is running. Stop it, then start it again with this recording.", error: true);
            return;
        }
        await Run(target, "Run", process.Id, sandboxOnly: true);
    }

    /// <summary>
    /// What another of your apps did with this call, when a copy reached it in the sandbox: its flow shares the trace
    /// and hangs off this call's span. Looked for in the running apps and in the open recording.
    /// </summary>
    private List<Flow> InsideOf(Flow outer, FlowStep call)
    {
        var candidates = Sessions.All().Where(s => s.Flows is not null && s.Repo != (outer.App ?? repo?.Name))
            .SelectMany(s => s.Flows!.Snapshot())
            .Concat(saved.FirstOrDefault(p => p.Id == procId)?.Flows ?? []);
        return candidates.Where(f => !ReferenceEquals(f, outer) && f.TraceId == outer.TraceId && f.App != outer.App && f.Root?.ParentId == call.Id)
            .DistinctBy(f => (f.App, f.Root?.Id)).ToList();
    }

    private RenderFragment Inside(Flow outer, ProcCall call) => __builder =>
    {
        foreach (var inner in InsideOf(outer, call.Step))
        {
            var steps = inner.Steps.Values.Where(s => s.Id != inner.Root?.Id && s.Category is "http" or "db").OrderBy(s => s.Start).ToList();
            <div class="inside">
                <div class="inside-head">
                    <Icon Name="layers" Size="13" /> Inside <b>@inner.App</b>
                    <span class="flow-meta">a copy of this call, handled by @inner.App running in the sandbox here · @(inner.Root?.StatusCode?.ToString() ?? "no answer") · @inner.Ms.ToString("0") ms</span>
                </div>
                @if (steps.Count == 0 && inner.Errors.Count == 0)
                {
                    <div class="flow-meta">It made no calls of its own.</div>
                }
                @foreach (var s in steps)
                {
                    var refused = s.StatusText?.Contains("RepoRunner sandbox", StringComparison.Ordinal) == true;
                    <div class="inside-row">
                        <span class="tk @(s.Category == "db" ? "sp" : "http")">@(s.Category == "db" ? "Database" : "Calls")</span>
                        <span class="mono">@(s.Category == "db" ? s.Tag("db.statement", "db.query.text", "db.operation") ?? s.Name : $"{s.Tag("http.request.method", "http.method")} {s.Tag("rr.url", "url.full", "http.url")}")</span>
                        @if (refused)
                        {
                            <span class="badge">refused by the sandbox</span>
                        }
                        else if (s.StatusCode is { } innerStatus)
                        {
                            <span class="badge @(innerStatus >= 400 ? "warn" : "ok")">@innerStatus</span>
                        }
                    </div>
                }
                @foreach (var error in inner.Errors.Take(3))
                {
                    var sandboxed = error.Message.Contains("RepoRunner sandbox", StringComparison.Ordinal);
                    <div class="inside-row">
                        <span class="tk @(sandboxed ? "env" : "http")">@(sandboxed ? "Stopped" : "Error")</span>
                        <span>@(sandboxed ? "It tried to reach " + Between(error.Message, "connection to ", " was refused") + ", which the sandbox refused. On a real server it would continue from here." : $"{error.Type.Split('.').Last()}: {error.Message}")</span>
                    </div>
                }
            </div>
        }
    };

    private static string Between(string text, string start, string end)
    {
        var a = text.IndexOf(start, StringComparison.Ordinal);
        if (a < 0) return "another system";
        a += start.Length;
        var b = text.IndexOf(end, a, StringComparison.Ordinal);
        return b < 0 ? text[a..] : text[a..b];
    }

    /// <summary>A captured body for display: secrets blanked, JSON indented.</summary>
    private string ShowBody(string text)
    {
        foreach (var secret in vars.Where(v => v.Secret && v.Value.Length >= 6).Select(v => v.Value))
            if (text.Contains(secret, StringComparison.Ordinal)) text = text.Replace(secret, "****");
        return Pretty(FlowHub.Redact(text));
    }

    private async Task Copy(string text)
    {
        try
