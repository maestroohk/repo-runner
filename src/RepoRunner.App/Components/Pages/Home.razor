    // ---------- loading ----------

    private void Reload()
    {
        repos = Vaults.Use(v => v.Repos());
        envs = Vaults.Use(v => v.Environments());
        unlocked = Vaults.UnlockedNames();
        sessions = Sessions.All();
        repo = repo is null ? null : repos.FirstOrDefault(r => r.Id == repo.Id);
        LoadRepo();
    }

    private void LoadRepo()
    {
        vars = [];
        files = [];
        targets = [];
        counts = [];
        solutions = [];
        if (repo is null) return;

        EnsureScan();
        LoadSaved();
        if (!envs.Any(e => e.Name == envName)) envName = envs[0].Name;
        var current = repo;
        var env = CurrentEnv;
        targets = Vaults.Use(v => v.Targets(current));
        solutions = DebugSupport.Solutions(current).Select(f => System.IO.Path.GetRelativePath(current.Path, f)).ToList();
        var rider = DebugSupport.RiderRecentSolutions();
        openInRider = solutions.Where(f => rider.TryGetValue(System.IO.Path.Combine(current.Path, f), out var info) && info.Open)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        counts = envs.ToDictionary(e => e.Name, e => Vaults.Use(v => v.CountVars(Scope.Repo(current.Id), e)));
        locked = !Vaults.IsUnlocked(env);
        if (locked) return;

        vars = Vaults.Use(v =>
        {
            var resolved = v.Resolve(current, env);
            return resolved.Values.OrderBy(p => p.Key, StringComparer.OrdinalIgnoreCase)
                .Select(p => new Variable(p.Key, p.Value, resolved.SecretNames.Contains(p.Key), resolved.Origins[p.Key])).ToList();
        });
        files = FindFiles(current);
        if (shown is null || shown.Repo != current.Name) shown = RepoSessions.LastOrDefault();
        _ = CheckSystems();
    }

    // ---------- before you run ----------

    private List<Preflight.Result>? preflight;
    private string? preflightKey;
    private bool preflightRunning;

    /// <summary>Asks each system the settings point at whether it is answering. Once per repo and environment, or on request.</summary>
    private async Task CheckSystems(bool force = false)
    {
        if (repo is null || locked) return;
        var key = $"{repo.Id}|{envName}";
        if (!force && key == preflightKey) return;
        preflightKey = key;
        preflight = null;
        if (CurrentEnv.Protected) return; // nothing of a protected environment is touched
        preflightRunning = true;
        var results = await Preflight.Check(Preflight.TargetsOf(vars));
        if (preflightKey != key) return;
        (preflight, preflightRunning) = (results, false);
        await InvokeAsync(StateHasChanged);
    }

    // ---------- search everything ----------

    private sealed record PaletteHit(string Kind, string Title, string Sub, string Url);

    private bool paletteOpen, paletteFocus;
    private string paletteQuery = "";
    private int paletteIndex;

    private void OpenPalette() => (paletteOpen, paletteFocus, paletteQuery, paletteIndex) = (true, true, "", 0);

    private void ClosePalette() => paletteOpen = false;

    private void PaletteKey(KeyboardEventArgs e)
    {
        var hits = PaletteHits();
        switch (e.Key)
        {
            case "Escape": ClosePalette(); break;
            case "ArrowDown": paletteIndex = Math.Min(paletteIndex + 1, Math.Max(0, hits.Count - 1)); break;
            case "ArrowUp": paletteIndex = Math.Max(0, paletteIndex - 1); break;
            case "Enter" when hits.Count > 0:
                var chosen = hits[Math.Min(paletteIndex, hits.Count - 1)];
                ClosePalette();
                Nav.NavigateTo(chosen.Url);
                break;
            default: if (e.Key.Length == 1 || e.Key == "Backspace") paletteIndex = 0; break;
        }
    }

    /// <summary>Repositories, processes, stored procedures, settings and recordings whose names hold every word typed.</summary>
    private List<PaletteHit> PaletteHits()
    {
        var words = paletteQuery.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        bool Has(params string?[] texts) => words.All(w => texts.Any(t => t?.Contains(w, StringComparison.OrdinalIgnoreCase) == true));
        var hits = new List<PaletteHit>();
        foreach (var r in repos.Where(r => Has(r.Name, r.Path)))
            hits.Add(new("Repository", r.Name, r.Path, UrlFor(r)));
        if (words.Length == 0) return hits;

        foreach (var r in repos)
        {
            if (Found.For(r).Map is not { } map) continue;
            foreach (var p in map.Processes.Where(p => Has(p.Name, p.Area, p.Route)).Take(8))
                hits.Add(new(p.Kind == "endpoint" ? "API" : p.Kind == "page" ? "Page" : "Job", p.Name, $"{r.Name} · {p.Area}", UrlFor(r, "found", FoundSlug(p.Key))));
            foreach (var group in map.Processes.SelectMany(p => p.Touches.Where(t => t.Kind == "sp" && Has(t.Title)).Select(t => (t.Title, Process: p)))
                         .GroupBy(x => x.Title).Take(8))
                hits.Add(new("Procedure", group.Key, $"{r.Name} · used by {group.Select(x => x.Process.Key).Distinct().Count()} process(es), e.g. {group.First().Process.Name}",
                    UrlFor(r, "found", FoundSlug(group.First().Process.Key))));
            foreach (var group in map.Processes.SelectMany(p => p.Touches.Where(t => t.Kind is "env" or "config" && Has(t.Title)).Select(t => (t.Title, Process: p)))
                         .GroupBy(x => x.Title).Take(5))
                hits.Add(new("Setting", group.Key, $"{r.Name} · read by {group.Select(x => x.Process.Key).Distinct().Count()} process(es)", UrlFor(r, "vars")));
        }
        if (repo is not null)
            foreach (var p in saved.Where(p => Has(p.Name, p.Reason)).Take(5))
                hits.Add(new(p.IsFailure ? "Kept failure" : "Recording", p.Name, $"{repo.Name} · {p.Created:d MMM HH:mm} on {p.Env}", UrlFor(repo, "processes", p.Id)));
        return hits.Take(14).ToList();
    }

    /// <summary>The role chosen for each repo's sandbox runs, kept while RepoRunner is open.</summary>
    private static readonly Dictionary<string, string> runAs = new(StringComparer.OrdinalIgnoreCase);

    private void RunAs(RunSession session, string? role)
    {
        if (string.IsNullOrEmpty(role) || session.Sandbox is null) return;
        session.Sandbox.RunAs(role);
        lock (runAs) runAs[session.Repo] = role;
        Say($"From the next sign-in you are {session.Sandbox.RoleName(role)}. Sign out of the app and choose the system again.");
    }

    private List<FileItem> FindFiles(RepoInfo current)
    {
        var own = vars.Where(v => v.Origin == "repo").ToDictionary(v => v.Name, v => v.Value, StringComparer.OrdinalIgnoreCase);
        bool InVault(List<KeyValuePair<string, string>> pairs) =>
            pairs.Count > 0 && pairs.All(p => own.TryGetValue(p.Key, out var value) && value == p.Value);

        var items = new List<FileItem>();
        foreach (var path in PlaintextFiles.Find(current.Path))
        {
            var relative = System.IO.Path.GetRelativePath(current.Path, path);
            try
            {
                if (System.IO.Path.GetFileName(path).Equals("launchSettings.json", StringComparison.OrdinalIgnoreCase))
                {
                    foreach (var profile in LaunchSettings.Read(path).Where(p => p.Variables.Count > 1))
                        items.Add(new FileItem(path, relative, profile.Name, profile.Variables, InVault(profile.Variables)));
                }
                else
                {
                    var pairs = DotEnv.Parse(File.ReadAllText(path));
                    if (pairs.Count > 0) items.Add(new FileItem(path, relative, null, pairs, InVault(pairs)));
                }
            }
            catch (Exception ex) when (ex is IOException or System.Text.Json.JsonException) { }
        }
        return items;
    }

