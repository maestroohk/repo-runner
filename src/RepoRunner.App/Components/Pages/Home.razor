    });

    private RenderFragment ErrorCard(FlowError error) => __builder =>
    {
        var origin = error.Origin;
        <div class="error-card @(error.Unhandled ? "unhandled" : "")">
            <div class="error-top">
                <Icon Name="alert" Size="15" />
                <span class="error-type">@error.Type.Split('.').Last()</span>
                <span class="badge @(error.Unhandled ? "bad" : "warn")">@(error.Unhandled ? "unhandled" : "thrown, then handled")</span>
            </div>
            <div class="error-message">@error.Message</div>
            @if (origin is not null)
            {
                <button class="frame origin" title="Open in Rider" @onclick="() => OpenFrame(origin)">
                    <Icon Name="pin" Size="13" />
                    <span class="mono">@System.IO.Path.GetFileName(origin.File):@origin.Line</span>
                    <span class="frame-method">@origin.Method.Split('.').Last()</span>
                    <Icon Name="external" Size="12" />
                </button>
            }
            @if (error.Frames.Count > 1)
            {
                <details class="more">
                    <summary>Call stack · @error.Frames.Count frames</summary>
                    @foreach (var frame in error.Frames)
                    {
                        @if (frame.File is not null)
                        {
                            <button class="frame" title="Open in Rider" @onclick="() => OpenFrame(frame)">
                                <span class="mono">@System.IO.Path.GetFileName(frame.File):@frame.Line</span>
                                <span class="frame-method">@frame.Method</span>
                            </button>
                        }
                        else
                        {
                            <div class="frame dim"><span class="frame-method">@frame.Method</span></div>
                        }
                    }
                </details>
            }
        </div>
    };

    /// <summary>The visible lines of the selected session, classified for colour, plus how many warnings were hidden.</summary>
    private (List<LogLine> Lines, int Hidden) LogView()
    {
        var lines = new List<LogLine>();
        var tags = new List<string>();
        var hidden = 0;
        foreach (var raw in shown?.Lines() ?? [])
        {
            string? tag = null;
            var text = raw;
            var close = raw.IndexOf("] ", StringComparison.Ordinal);
            if (raw.StartsWith('[') && close is > 1 and < 32 && !raw.StartsWith("[rr-debug]"))
            {
                tag = raw[1..close].Trim();
                text = raw[(close + 2)..];
                if (!tags.Contains(tag)) tags.Add(tag);
            }
            var kind =
                text.Contains(": warning ") ? "warn"
                : text.Contains(": error ") || text.Contains("Unhandled exception") || text.Contains(" ERR]") || text.StartsWith("fail:") || text.StartsWith("Failed:") ? "err"
                : text.Contains("Now listening on") || text.Contains("started successfully") || text.Contains("debugger attached") ? "ok"
                : tag is null ? "sys" : "";
            if (kind == "warn" && hideWarnings) { hidden++; continue; }
            lines.Add(new LogLine(tag, tag is null ? 0 : tags.IndexOf(tag) % 4, text, kind));
        }
        return (lines, hidden);
    }

    private void Try(Action work)
    {
        try { work(); }
        catch (VaultException ex) { Say(ex.Message, error: true); }
    }

    private void Confirm(string key, Action action)
    {
        if (confirmKey != key) { confirmKey = key; return; }
        confirmKey = null;
        action();
    }

    private static string Elapsed(RunSession s)
    {
        var span = (s.Ended ?? DateTime.Now) - s.Started;
        return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss");
    }

    private string RunLabel(TargetDef target, string mode) =>
        confirmKey == $"run:{target.Name}:{mode}" ? $"Click again to {mode.ToLowerInvariant()} on {envName}" : mode;

    // ---------- repos and environments ----------

    private void SelectRepo(RepoInfo selected)
    {
        repo = selected;
        if (selected.DefaultEnv is { } preferred && envs.Any(e => e.Name == preferred)) envName = preferred;
        revealed.Clear();
        editing = showPaste = false;
        confirmKey = null;
        shown = null;
        filter = "";
        codeFeature = null;
        LoadRepo();
        tab = RepoSessions.Any(s => s.Running) ? "output" : "vars";
    }

    private void SelectEnv(string name)
    {
        envName = name;
        revealed.Clear();
        editing = showPaste = false;
        confirmKey = null;
        var current = repo!;
        Vaults.Use(v => v.SetRepoDefaults(current, null, name)); // reopen on the environment last used
        Reload();
    }

    private void OpenAdd()
    {
        showAdd = true;
        addPath = addName = "";
        var known = repos.Select(r => r.Path).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var roots = repos.Select(r => System.IO.Path.GetDirectoryName(r.Path))
            .Append(System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "source", "repos"))
            .Where(d => d is not null && Directory.Exists(d)).Distinct(StringComparer.OrdinalIgnoreCase);
        folderSuggestions = roots.SelectMany(d => Directory.GetDirectories(d!)).Where(d => !known.Contains(d))
            .OrderBy(d => d, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void AddRepo() => Try(() =>
    {
        if (string.IsNullOrWhiteSpace(addPath)) throw new VaultException("Enter the repo's folder.");
        var added = Vaults.Use(v =>
        {
            var created = v.AddRepo(addPath.Trim().Trim('"'), string.IsNullOrWhiteSpace(addName) ? null : addName.Trim());
            var detected = Detector.Detect(created.Path);
            foreach (var target in detected.Targets) v.SaveTarget(created, target);
            v.SetRepoDefaults(created, detected.DefaultTarget, null);
            v.Audit("add", created.Name);
            return (Repo: v.GetRepo(created.Name), Count: detected.Targets.Count);
        });
        showAdd = false;
        repo = added.Repo;
        shown = null;
        Reload();
        Say($"Added {added.Repo.Name} with {added.Count} run target(s).");
    });

    // ---------- running ----------

    private void Run(TargetDef target, string mode)
    {
        var env = CurrentEnv;
        if (!Vaults.IsUnlocked(env)) { OpenUnlock(() => Run(target, mode)); return; }
        var key = $"run:{target.Name}:{mode}";
        if (env.Protected && confirmKey != key) { confirmKey = key; return; }
        confirmKey = null;
        Try(() =>
        {
            shown = Sessions.Start(Vaults, repo!, env, target, watch: mode == "Watch", debug: mode == "Debug");
            tab = "output";
            sessions = Sessions.All();
        });
    }

    private void StopSession(RunSession session) => Sessions.Stop(session);

    private string SolutionOf(TargetDef target) =>
        DebugSupport.FindSolution(repo!, target) is { } full ? System.IO.Path.GetRelativePath(repo!.Path, full) : "";

    private void SetSolution(TargetDef target, string? relative) => Try(() =>
    {
        if (string.IsNullOrEmpty(relative)) return;
        var current = repo!;
        target.Solution = relative;
        Vaults.Use(v => v.SaveTarget(current, target));
        Say($"{target.Name} will be debugged with {relative}.");
    });

    private void Dismiss(RunSession session)
    {
        Sessions.Dismiss(session);
        sessions = Sessions.All();
        shown = RepoSessions.LastOrDefault();
    }

    private void Quit() => Lifetime.StopApplication();

