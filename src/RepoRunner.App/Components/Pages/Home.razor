@page "/"
@page "/repo/{RepoName}"
@page "/repo/{RepoName}/{Section}"
@page "/repo/{RepoName}/{Section}/{Item}"
@page "/flow/{FocusRepo}"
@inject NavigationManager Nav
@inject Discoveries Found
@implements IDisposable
@inject VaultService Vaults
@inject SessionManager Sessions
@inject ProcessStore Recordings
@inject Resender Sender
@inject FailureKeeper Keeper
@inject IHostApplicationLifetime Lifetime
@inject IJSRuntime JS

<PageTitle>RepoRunner</PageTitle>

<div class="rr-app @(Focused ? "focus" : "")">
    <aside class="sidebar">
        <div class="side-top">
            <a class="brand" href="" title="All repositories"><span class="logo"><Icon Name="play" Size="12" /></span><span class="brand-name">RepoRunner</span></a>
            <button class="icon-btn nav-toggle" title="Collapse or expand the menu" aria-label="Collapse or expand the menu" onclick="rrToggleNav()"><Icon Name="layers" Size="15" /></button>
        </div>

        <button class="palette-open" title="Search everything (Ctrl+K)" @onclick="OpenPalette">
            <Icon Name="search" Size="13" /> <span>Search</span> <kbd>Ctrl K</kbd>
        </button>

        <div class="nav-label">
            Repositories
            <button class="icon-btn" title="Add a repo" @onclick="OpenAdd"><Icon Name="plus" /></button>
        </div>

        @foreach (var r in repos)
        {
            var running = sessions.Any(s => s.Running && s.Repo == r.Name);
            <a class="repo-item @(repo?.Id == r.Id ? "active" : "")" href="@UrlFor(r)" title="Open @r.Name at its front page">
                <span class="avatar" style="--hue:@Hue(r.Name)">@Initials(r.Name)</span>
                <span class="repo-text">
                    <span class="repo-name">@r.Name</span>
                    <span class="repo-sub">@(running ? "running" : r.DefaultEnv ?? "not run yet")</span>
                </span>
                @if (running)
                {
                    <span class="pulse"></span>
                }
            </a>
        }
        @if (repos.Count == 0 && !showAdd)
        {
            <div class="side-empty">No repositories yet.</div>
        }

        @if (showAdd)
        {
            <div class="add-form">
                <label class="field">
                    <span>Repo folder</span>
                    <input class="input" list="repo-folders" placeholder="C:\...\source\repos\MyApi" @bind="addPath" @bind:event="oninput" />
                </label>
                <datalist id="repo-folders">
                    @foreach (var folder in folderSuggestions)
                    {
                        <option value="@folder"></option>
                    }
                </datalist>
                <label class="field">
                    <span>Name (optional)</span>
                    <input class="input" placeholder="taken from the folder" @bind="addName" />
                </label>
                <div class="row">
                    <button class="btn primary small" @onclick="AddRepo">Add repo</button>
                    <button class="btn small" @onclick="() => showAdd = false">Cancel</button>
                </div>
            </div>
        }

        <div class="view-switch" role="group" aria-label="Look">
            <span class="nav-label">Look</span>
            <div class="seg">
                <button class="seg-opt @(view == "control" ? "active" : "")" title="Dark and dense, the map in the middle" @onclick="@(() => SetView("control"))">Control room</button>
                <button class="seg-opt @(view == "transit" ? "active" : "")" title="Light and told as a story, stop by stop" @onclick="@(() => SetView("transit"))">Transit line</button>
            </div>
        </div>
        <div class="sidebar-foot">
            <div class="vault-pill" title="@Vaults.VaultFile"><Icon Name="shield" /> Vault encrypted</div>
            @if (unlocked.Count > 0)
            {
                <button class="foot-btn danger" @onclick="LockAll"><Icon Name="lock" /> Lock @string.Join(", ", unlocked) now</button>
            }
            <button class="foot-btn" @onclick="@(() => Confirm("quit", Quit))">
                <Icon Name="power" /> @(confirmKey == "quit" ? "Click again to quit" : "Quit RepoRunner")
            </button>
        </div>
    </aside>

    <main class="content">
        @if (repo is null && repos.Count > 0)
        {
            <div class="content-inner">
                <nav class="crumbs" aria-label="Where you are"><span class="crumb current"><Icon Name="layers" Size="13" /> All repositories</span></nav>
                <header class="home-head">
                    <h1>Your repositories</h1>
                    <p>Pick one to run it, see how it works inside, or look at what happened in a run.</p>
                </header>
                @if (RepoName is not null)
                {
                    <div class="callout"><Icon Name="alert" /><div>There is no repository called “@RepoName”. It may have been removed.</div></div>
                }
                <div class="home-grid">
                    @foreach (var r in repos)
                    {
                        var running = sessions.Where(x => x.Running && x.Repo == r.Name).ToList();
                        <a class="home-card" href="@UrlFor(r)">
                            <span class="avatar lg" style="--hue:@Hue(r.Name)">@Initials(r.Name)</span>
                            <span class="home-card-text">
                                <b>@r.Name</b>
                                <span class="path">@r.Path</span>
                                <span class="home-card-state">
                                    @if (running.Count > 0)
                                    {
                                        <span class="live-pill small"><span class="pulse"></span> running on @running[0].Env@(running[0].Sandbox is not null ? " · sandbox" : "")</span>
                                    }
                                    else
                                    {
                                        <span class="flow-meta">Not running@(r.DefaultEnv is { } e ? $" · last used on {e}" : "")</span>
                                    }
                                </span>
                            </span>
                            <Icon Name="next" Size="16" />
                        </a>
                    }
                </div>
            </div>
        }
        else if (repo is null)
        {
            <div class="welcome">
                <span class="logo"><Icon Name="play" Size="22" /></span>
                <h1>Run any repo on any environment</h1>
                <p>RepoRunner keeps each repo's variables in an encrypted vault and starts the app with them. No .env files, nothing set in Windows.</p>
                <button class="btn primary" @onclick="OpenAdd"><Icon Name="plus" /> Add your first repo</button>
            </div>
        }
        else
        {
            <div class="content-inner fit">
                <nav class="crumbs" aria-label="Where you are">
                    @if (Focused)
                    {
                        <a class="crumb back" href="@UrlFor(repo, "flow")" title="Back to the full RepoRunner window"><Icon Name="back" Size="13" /> Back to @repo.Name</a>
                    }
                    else
                    {
                        <a class="crumb" href="" title="All repositories"><Icon Name="layers" Size="13" /> All repositories</a>
                        <span class="crumb-sep">›</span>
                        <a class="crumb @(SectionTitle is null ? "current" : "")" href="@UrlFor(repo)" title="Back to the top of @repo.Name">@repo.Name</a>
                        @if (SectionTitle is { } sectionTitle)
                        {
                            <span class="crumb-sep">›</span>
                            <a class="crumb @(ItemTitle is null ? "current" : "")" href="@UrlFor(repo, tab)">@sectionTitle</a>
                        }
                        @if (ItemTitle is { } itemTitle)
                        {
                            <span class="crumb-sep">›</span>
                            <span class="crumb current">@itemTitle</span>
                        }
                    }
                </nav>
                @if (Focused)
                {
                    <div class="focus-bar">
                        <span class="avatar" style="--hue:@Hue(repo.Name)">@Initials(repo.Name)</span>
                        <b>@repo.Name</b>
                        <span class="badge">@envName</span>
                        @if (flowSession is { Running: true })
                        {
                            <span class="live-pill"><span class="pulse"></span> running · @Elapsed(flowSession)</span>
                        }
                        else
                        {
                            <span class="flow-meta">Not running. Start it from the main RepoRunner tab.</span>
                        }
                        <span class="spacer"></span>
                        <div class="seg">
                            <button class="seg-opt @(tab == "processes" ? "active" : "")" @onclick="@(() => tab = "processes")">Recordings</button>
                            <button class="seg-opt @(tab == "flow" ? "active" : "")" @onclick="@(() => tab = "flow")">Live map</button>
                            <button class="seg-opt @(tab == "features" ? "active" : "")" @onclick="@(() => tab = "features")">Features and code paths</button>
                        </div>
                    </div>
                }
                <header class="page-head">
                    <div class="title-block">
                        <span class="avatar lg" style="--hue:@Hue(repo.Name)">@Initials(repo.Name)</span>
                        <div>
                            <h1>@repo.Name</h1>
                            <div class="path"><Icon Name="folder" Size="13" /> @repo.Path</div>
                        </div>
                    </div>
                    <div class="env-switch" role="tablist" aria-label="Environment">
                        @foreach (var e in envs)
                        {
                            <button class="env-opt tone-@Tone(e) @(e.Name == envName ? "active" : "")" role="tab" title="@EnvTitle(e)" @onclick="() => SelectEnv(e.Name)">
                                <span class="env-dot"></span>
                                @e.Name
                                @if (e.Protected)
                                {
                                    <Icon Name="@(Vaults.IsUnlocked(e) ? "unlock" : "lock")" Size="12" />
                                }
                                <span class="env-count">@(counts.GetValueOrDefault(e.Name))</span>
                            </button>
                        }
                    </div>
                </header>

                @{ var safetyEnv = envs.FirstOrDefault(e => e.Name == envName); }
                @if (!Focused)
                {
                    // Inside a tab the run targets fold into one line, so what was opened starts at the top.
                    var running = RepoSessions.Where(x => x.Running).ToList();
                    <div class="run-line">
                        <Icon Name="@(safetyEnv?.Live == true ? "globe" : "shield")" Size="14" />
                        @if (running.Count > 0)
                        {
                            @foreach (var r in running)
                            {
                                <span class="live-pill small"><span class="pulse"></span> @r.Target · @r.Env@(r.Sandbox is not null ? " · sandbox" : "") · @Elapsed(r)</span>
                                @if (r.Url is not null)
                                {
                                    <a class="btn small" href="@r.Url" target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, '_blank', 'noopener'); return false;">Open app <Icon Name="external" Size="12" /></a>
                                }
                                <button class="btn small stop" @onclick="() => StopSession(r)"><Icon Name="stop" Size="10" /> Stop</button>
                            }
                        }
                        else
                        {
                            <span class="flow-meta">Nothing running. @(safetyEnv?.Live == true ? $"{envName} is live." : $"Apps started on {envName} run in the sandbox.")</span>
                        }
                        <span class="spacer"></span>
                        <a class="btn small" href="@UrlFor(repo)"><Icon Name="play" Size="11" /> Run</a>
                    </div>
                }

                <section class="panel">
                    <div class="panel-tabs" role="tablist">
                        <button class="ptab @(tab == "run" ? "active" : "")" title="Start the app, and see how safely it will run" @onclick="@(() => ShowTab("run"))">
                            <Icon Name="power" /> Run
                        </button>
                        <button class="ptab @(tab == "vars" ? "active" : "")" @onclick="@(() => ShowTab("vars"))">
                            <Icon Name="key" /> Variables <span class="tab-count">@(locked ? "–" : vars.Count.ToString())</span>
                        </button>
                        <button class="ptab @(tab == "output" ? "active" : "")" @onclick="@(() => ShowTab("output"))">
                            <Icon Name="terminal" /> Output
                            @if (RepoSessions.Any(s => s.Running))
                            {
                                <span class="pulse"></span>
                            }
                        </button>
                        <button class="ptab @(tab == "found" ? "active" : "")" title="What people can do in this app, worked out from its code" @onclick="@(() => ShowTab("found"))">
                            <Icon Name="layers" /> Processes
                            @if (Found.For(repo).Map is { } foundMap)
                            {
                                <span class="tab-count">@foundMap.Processes.Count</span>
                            }
                            else
                            {
                                <span class="pulse" title="Reading the code"></span>
                            }
                        </button>
                        <button class="ptab @(tab == "processes" ? "active" : "")" @onclick="@(() => ShowTab("processes"))">
                            <Icon Name="play" /> Recordings
                            @if (recordingSince is not null)
                            {
                                <span class="rec-dot on"></span>
                            }
                            else if (saved.Count(p => p.IsFailure) is > 0 and var keptFailures)
                            {
                                <span class="tab-count bad" title="Failures kept automatically">@keptFailures</span>
                            }
                            else if (saved.Count > 0)
                            {
                                <span class="tab-count">@saved.Count</span>
                            }
                        </button>
                        <button class="ptab @(tab == "flow" ? "active" : "")" @onclick="@(() => ShowTab("flow"))">
                            <Icon Name="flow" /> Live map
                            @if (AllFlows.Count(f => f.Outcome == "failed") is > 0 and var failedFlows)
                            {
                                <span class="tab-count bad">@failedFlows</span>
                            }
                            else if (RepoSessions.Any(x => x.Running && x.Flows is not null))
                            {
                                <span class="pulse"></span>
                            }
                        </button>
                        <button class="ptab @(tab == "features" ? "active" : "")" @onclick="@(() => ShowTab("features"))">
                            <Icon Name="code" /> Code paths
                            @if (scan is not null)
                            {
                                <span class="tab-count">@scan.Features.Count</span>
                            }
                        </button>
                        @if (files.Count > 0 || tab == "files")
                        {
                            <button class="ptab @(tab == "files" ? "active" : "")" title="Files in the repo that hold settings in plain text" @onclick="@(() => ShowTab("files"))">
                                <Icon Name="file" /> Plain-text settings
                                <span class="tab-count warn">@files.Count</span>
                            </button>
                        }
                    </div>

                    <div class="panel-body">
                        @if (TabHint(tab) is { } hint)
                        {
                            <p class="tab-hint">@hint</p>
                        }
                        @if (tab == "run")
                        {
                            @RunZone()
                        }
                        else if (tab == "found")
                        {
                            <ProcessesView View="@view" Repo="repo" Entry="Found.For(repo)" Others="OtherMaps()" EnvName="@envName"
                                           KnownSettings="@(locked ? null : vars.Select(v => v.Name).ToHashSet(StringComparer.OrdinalIgnoreCase))"
                                           OpenKey="@foundKey" OnOpen="OpenFound" OnRescan="() => Found.Rescan(repo)"
                                           LinkTo="@((name, key) => repos.FirstOrDefault(r => r.Name == name) is { } other ? UrlFor(other, "found", FoundSlug(key)) : "")" />
                        }
                        else if (tab == "output")
                        {
                            @if (RepoSessions.Count == 0)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="terminal" Size="22" /></span>
                                    <h3>Nothing has run yet</h3>
                                    <p>Press Run on a target above. Its output streams here, with secret values masked.</p>
                                </div>
                            }
                            else
                            {
                                var view = LogView();
                                <div class="toolbar">
                                    @foreach (var s in RepoSessions)
                                    {
                                        <button class="session-chip @(s.Id == shown?.Id ? "active" : "")" @onclick="() => shown = s">
                                            @if (s.Running)
                                            {
                                                <span class="pulse"></span>
                                            }
                                            @s.Labels · @s.Env@(s.Running ? "" : " · ended")
                                        </button>
                                    }
                                    <span class="spacer"></span>
                                    <label class="check"><input type="checkbox" @bind="hideWarnings" /> Hide build warnings@(view.Hidden > 0 ? $" ({view.Hidden})" : "")</label>
                                    @if (shown is { Running: false })
                                    {
                                        <button class="btn small" @onclick="() => Dismiss(shown)">Clear</button>
                                    }
                                </div>
                                <div class="terminal">
                                    <div class="terminal-bar">
                                        <span class="terminal-dots"><i></i><i></i><i></i></span>
                                        <span>@(shown is null ? "" : $"{shown.Repo} · {shown.Labels} · {shown.Env} · started {shown.Started:HH:mm:ss}")</span>
                                    </div>
                                    <div class="log" @ref="logElement">
                                        @foreach (var line in view.Lines)
                                        {
                                            <div class="ln @line.Kind">@if (line.Tag is not null){<span class="tag t@(line.TagIndex)">@line.Tag</span>}@line.Text</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (tab == "flow")
                        {
                            @if (flowSession is null)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="flow" Size="22" /></span>
                                    <h3>Watch a feature travel through the system</h3>
                                    <p>Run a .NET target, then use the app. This view draws the app and everything it talks to, shows each message moving between them, and lets you replay a request one step at a time.</p>
                                </div>
                            }
                            else if (flowSession.Flows is null)
                            {
                                <div class="state locked">
                                    <span class="glyph"><Icon Name="lock" Size="22" /></span>
                                    <h3>Recording is off for @flowSession.Env</h3>
                                    <p>Flows carry real request data, so they are never recorded for a protected environment or for non-.NET targets.</p>
                                </div>
                            }
                            else
                            {
                                var flows = FlowsInView();
                                var map = BuildMap(flows);
                                var picked = flows.FirstOrDefault(f => f.TraceId == flowId);
                                var events = picked is null ? [] : EventsOf(picked, map);
                                var at = Math.Clamp(eventIndex, 0, Math.Max(0, events.Count - 1));
                                var current = events.Count > 0 ? events[at] : null;
                                var focus = map.Nodes.FirstOrDefault(n => n.Key == selectedNode);

                                <div class="stage">
                                    <div class="canvas">
                                        <div class="canvas-bar">
                                            @if (!Focused)
                                            {
                                                <a class="icon-btn" title="Open the map in its own tab" href="flow/@Uri.EscapeDataString(repo.Name)" target="_blank" rel="noopener"
                                                   onclick="window.open(this.href, '_blank', 'noopener'); return false;"><Icon Name="expand" /></a>
                                            }
                                            <span class="canvas-title">
                                                @if (flowSession.Running)
                                                {
                                                    <span class="pulse"></span>
                                                }
                                                @(picked is not null ? "Replaying one flow" : flowSession.Running ? "Live" : "Recording ended")
                                            </span>
                                            @if (featureFilter is not null)
                                            {
                                                <span class="badge accent">
                                                    @featureFilter.Verb @(featureFilter.Route ?? featureFilter.Name)
                                                    <button class="chip-x" title="Show every feature" @onclick="() => featureFilter = null"><Icon Name="x" Size="11" /></button>
                                                </span>
                                            }
                                            <span class="spacer"></span>
                                            <span class="legend"><i class="lg ok"></i>healthy <i class="lg bad"></i>failing <i class="lg idle"></i>configured, unused</span>
                                        </div>
                                        <svg class="map" viewBox="0 0 760 @map.Height" role="img" aria-label="How messages travel between @repo.Name and what it depends on">
                                            @foreach (var edge in map.Edges)
                                            {
                                                <path class="edge @edge.State @(current?.EdgeKey == edge.Key ? "current" : "")" d="@edge.Path" />
                                            }
                                            @foreach (var node in map.Nodes)
                                            {
                                                <g class="node @node.Kind @node.State @(selectedNode == node.Key ? "selected" : "") @(current?.NodeKey == node.Key ? "current" : "")"
                                                   transform="translate(@N(node.X),@N(node.Y))" @onclick="() => PickNode(node.Key)">
                                                    <title>@node.Tip</title>
                                                    <rect class="node-box" width="@N(node.W)" height="@N(node.H)" rx="14" />
                                                    <rect class="node-icon" x="10" y="@N(node.H / 2 - 17)" width="34" height="34" rx="9" />
                                                    <g transform="translate(18,@N(node.H / 2 - 9))"><Icon Name="@node.Icon" Size="18" /></g>
                                                    @SvgText("node-name", 54, node.H / 2 - 2, node.Name)
                                                    @SvgText("node-sub", 54, node.H / 2 + 14, node.Sub)
                                                    @if (node.Stat is not null)
                                                    {
                                                        @SvgText("node-stat", node.W - 12, 18, node.Stat, "end")
                                                    }
                                                </g>
                                            }
                                            @if (current?.Path is not null)
                                            {
                                                <circle @key="packetKey" class="packet @current.Motion @(current.Failed ? "bad" : "")" r="7" style="offset-path: path('@current.Path')" />
                                            }
                                        </svg>
                                        @if (picked is not null && events.Count > 0)
                                        {
                                            <div class="transport">
                                                <button class="icon-btn" title="Previous step" disabled="@(at == 0)" @onclick="() => Step(-1, events.Count)"><Icon Name="prev" /></button>
                                                <button class="btn primary small" @onclick="() => TogglePlay(events.Count)">
                                                    <Icon Name="@(playing ? "pause" : "play")" Size="12" /> @(playing ? "Pause" : at >= events.Count - 1 ? "Replay" : "Play")
                                                </button>
                                                <button class="icon-btn" title="Next step" disabled="@(at >= events.Count - 1)" @onclick="() => Step(1, events.Count)"><Icon Name="next" /></button>
                                                <span class="transport-pos">Step @(at + 1) of @events.Count</span>
                                                <span class="transport-now">@current?.Direction</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="transport hint">Click a device to see what it needs. Pick a flow on the right to replay it step by step.</div>
                                        }
                                    </div>

                                    <div class="inspector">
                                        @if (picked is not null)
                                        {
                                            var (verb, label, host) = Describe(picked);
                                            <div class="insp-head">
                                                <button class="icon-btn" title="Back to all flows" @onclick="CloseFlow"><Icon Name="back" /></button>
                                                @if (verb is not null)
                                                {
                                                    <span class="verb v-@verb.ToLowerInvariant()">@verb</span>
                                                }
                                                <h3 title="@label">@label</h3>
                                            </div>
                                            <div class="facts">
                                                <span class="badge @(picked.Outcome == "failed" ? "bad" : picked.Outcome == "warn" ? "warn" : "ok")">@(picked.Outcome == "failed" ? "Failed" : picked.Outcome == "warn" ? "Exceptions" : "Clean")</span>
                                                @if (picked.StatusCode is { } httpCode)
                                                {
                                                    <span class="fact">Status <b>@httpCode</b></span>
                                                }
                                                <span class="fact">Took <b>@picked.Ms.ToString("0") ms</b></span>
                                                <span class="fact">At <b>@picked.FirstSeen.ToLocalTime().ToString("HH:mm:ss")</b></span>
                                                @if (host is not null)
                                                {
                                                    <span class="fact">To <b>@host</b></span>
                                                }
                                            </div>

                                            <ol class="events">
                                                @for (var i = 0; i < events.Count; i++)
                                                {
                                                    var index = i;
                                                    var ev = events[i];
                                                    <li class="event @(index == at ? "current" : "") @(ev.Failed ? "failed" : ev.Error is not null ? "warn" : "")">
                                                        <button class="event-head" @onclick="() => GoTo(index)">
                                                            <span class="event-n">@(index + 1)</span>
                                                            <span class="event-text">
                                                                <span class="event-dir">@ev.Direction</span>
                                                                <span class="event-title">@ev.Title</span>
                                                            </span>
                                                            @if (ev.Notes.Count > 0)
                                                            {
                                                                <span class="badge accent">data</span>
                                                            }
                                                            @if (ev.Code is { } evCode)
                                                            {
                                                                <span class="badge @(evCode >= 400 ? "bad" : "ok")">@evCode</span>
                                                            }
                                                            @if (ev.Ms is { } evMs)
                                                            {
                                                                <span class="event-ms">@evMs.ToString("0") ms</span>
                                                            }
                                                        </button>
                                                        @if (index == at)
                                                        {
                                                            <div class="event-body">
                                                                @if (ev.Error is not null)
                                                                {
                                                                    @ErrorCard(ev.Error)
                                                                }
                                                                @foreach (var note in ev.Notes)
                                                                {
                                                                    <div class="capture">
                                                                        <div class="capture-head"><Icon Name="box" Size="13" /> @note.Label</div>
                                                                        <pre>@Pretty(note.Body)</pre>
                                                                    </div>
                                                                }
                                                                @if (ev.Step is not null && picked.Bodies.TryGetValue(ev.Step.Id, out var hopData))
                                                                {
                                                                    @BodyCards(hopData)
                                                                }
                                                                @if (ev.Frames is { Count: > 0 })
                                                                {
                                                                    <div class="capture">
                                                                        <div class="capture-head"><Icon Name="code" Size="13" /> Made by your code</div>
                                                                        <div class="callers">
                                                                            @foreach (var frame in ev.Frames.Take(12))
                                                                            {
                                                                                <button class="frame" title="Open in Rider" @onclick="() => OpenFrame(frame)">
                                                                                    <span class="frame-name">@ShortMethod(frame.Method)</span>
                                                                                    <span class="mono frame-at">@System.IO.Path.GetFileName(frame.File):@frame.Line</span>
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (ev.Step is not null)
                                                                {
                                                                    <details class="more">
                                                                        <summary>Details</summary>
                                                                        <table class="tags">
                                                                            <tr><td>source</td><td>@ev.Step.Source</td></tr>
                                                                            <tr><td>started</td><td>@ev.Step.Start.ToLocalTime().ToString("HH:mm:ss.fff")</td></tr>
                                                                            @if (ev.Step.StatusText is not null)
                                                                            {
                                                                                <tr><td>status</td><td>@ev.Step.StatusText</td></tr>
                                                                            }
                                                                            @foreach (var tag in ev.Step.Tags.OrderBy(t => t.Key))
                                                                            {
                                                                                <tr><td>@tag.Key</td><td>@tag.Value</td></tr>
                                                                            }
                                                                        </table>
                                                                    </details>
                                                                }
                                                                @if (ev.Error is null && ev.Notes.Count == 0 && ev.Step is null)
                                                                {
                                                                    <div class="flow-meta">Nothing more was captured for this step.</div>
                                                                }
                                                            </div>
                                                        }
                                                    </li>
                                                }
                                            </ol>
                                        }
                                        else if (focus is not null)
                                        {
                                            var calls = CallsTo(flows, focus.Key);
                                            <div class="insp-head">
                                                <button class="icon-btn" title="Back to all flows" @onclick="() => selectedNode = null"><Icon Name="back" /></button>
                                                <span class="device-icon @focus.Kind"><Icon Name="@focus.Icon" Size="16" /></span>
                                                <h3 title="@focus.Tip">@focus.FullName</h3>
                                            </div>
                                            <div class="facts">
                                                <span class="fact">@(focus.Kind == "app" ? "Requests" : "Calls") <b>@calls.Count</b></span>
                                                <span class="fact">Failed <b class="@(calls.Any(c => c.Failed) ? "bad-text" : "")">@calls.Count(c => c.Failed)</b></span>
                                                @if (calls.Count > 0)
                                                {
                                                    <span class="fact">Average <b>@calls.Average(c => c.Ms).ToString("0") ms</b></span>
                                                }
                                            </div>
                                            @if (focus.Address is not null)
                                            {
                                                <div class="needs">
                                                    <div class="needs-title">Address</div>
                                                    <div class="mono">@focus.Address</div>
                                                </div>
                                            }
                                            @if (focus.Variables.Count > 0)
                                            {
                                                <div class="needs">
                                                    <div class="needs-title">Set by @(focus.Variables.Count == 1 ? "this variable" : "these variables") in @envName</div>
                                                    @foreach (var name in focus.Variables)
                                                    {
                                                        <span class="badge accent mono">@name</span>
                                                    }
                                                </div>
                                            }
                                            else if (focus.Kind == "service")
                                            {
                                                <div class="needs">
                                                    <div class="needs-title">Not in the vault</div>
                                                    <div class="flow-meta">No variable in @envName points at this address. It is set somewhere else: appsettings, code, or a variable RepoRunner does not hold.</div>
                                                </div>
                                            }
                                            <div class="needs-title pad-top">@(calls.Count == 0 ? "No traffic recorded yet" : "Most recent")</div>
                                            <div class="flow-list">
                                                @foreach (var call in calls.Take(40))
                                                {
                                                    <button class="flow-item @(call.Failed ? "failed" : "ok")" @onclick="() => OpenFlow(call.Flow.TraceId, call.Step.Id)">
                                                        <span class="flow-mark"></span>
                                                        <span class="flow-text">
                                                            <span class="flow-line">
                                                                @if (call.Verb is not null)
                                                                {
                                                                    <span class="verb v-@call.Verb.ToLowerInvariant()">@call.Verb</span>
                                                                }
                                                                <span class="flow-title">@call.Label</span>
                                                            </span>
                                                            <span class="flow-meta">@call.Step.Start.ToLocalTime().ToString("HH:mm:ss") @(call.Step.StatusCode is { } c ? $"· {c} " : "")· @call.Ms.ToString("0") ms</span>
                                                        </span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            var rows = FlowRows(flows);
                                            <div class="scores">
                                                <div class="score"><b>@flows.Count</b><span>flows</span></div>
                                                <div class="score ok"><b>@flows.Count(f => f.Outcome == "ok")</b><span>clean</span></div>
                                                <div class="score warn"><b>@flows.Count(f => f.Outcome == "warn")</b><span>exceptions</span></div>
                                                <div class="score bad"><b>@flows.Count(f => f.Outcome == "failed")</b><span>failed</span></div>
                                            </div>
                                            var noticed = Insights(flows, map);
                                            @if (noticed.Count > 0)
                                            {
                                                <div class="noticed">
                                                    <div class="needs-title">Worth a look</div>
                                                    @foreach (var notice in noticed)
                                                    {
                                                        <button class="notice @notice.Kind" @onclick="notice.Go">
                                                            <Icon Name="@(notice.Kind == "bad" ? "alert" : "eye")" Size="14" />
                                                            <span>@notice.Text</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            <div class="insp-tools">
                                                <div class="seg">
                                                    @foreach (var (key, name) in FlowViews)
                                                    {
                                                        <button class="seg-opt @(flowView == key ? "active" : "")" @onclick="() => flowView = key">@name</button>
                                                    }
                                                </div>
                                                <button class="icon-btn" title="Clear recorded flows" @onclick="ClearFlows"><Icon Name="trash" /></button>
                                            </div>
                                            <div class="search wide">
                                                <Icon Name="search" />
                                                <input class="input" placeholder="Filter by path, address or exception" @bind="flowFilter" @bind:event="oninput" />
                                            </div>
                                            @if (rows.Count == 0)
                                            {
                                                <div class="state small">
                                                    <p>@(flows.Count == 0 ? (flowSession.Running ? "Recording. Use the app and its requests appear here." : "Nothing was recorded.") : "Nothing matches this view.")</p>
                                                </div>
                                            }
                                            <div class="flow-list">
                                                @foreach (var row in rows.Take(200))
                                                {
                                                    <button class="flow-item @row.Flow.Outcome" @onclick="() => OpenFlow(row.Flow.TraceId, null)">
                                                        <span class="flow-mark"></span>
                                                        <span class="flow-text">
                                                            <span class="flow-line">
                                                                @if (row.Verb is not null)
                                                                {
                                                                    <span class="verb v-@row.Verb.ToLowerInvariant()">@row.Verb</span>
                                                                }
                                                                <span class="flow-title">@row.Label</span>
                                                                @if (row.Count > 1)
                                                                {
                                                                    <span class="times">×@row.Count</span>
                                                                }
                                                            </span>
                                                            <span class="flow-meta">
                                                                @row.Flow.FirstSeen.ToLocalTime().ToString("HH:mm:ss")
                                                                @if (row.Host is not null)
                                                                {
                                                                    <span> · @row.Host</span>
                                                                }
                                                                @if (row.Flow.StatusCode is { } rowCode)
                                                                {
                                                                    <span> · @rowCode</span>
                                                                }
                                                                @if (row.Flow.Steps.Count > 0)
                                                                {
                                                                    <span> · @row.Flow.Ms.ToString("0") ms</span>
                                                                }
                                                                @if (row.Flow.Errors.Count > 0)
                                                                {
                                                                    <span> · @row.Flow.Errors.Count exception@(row.Flow.Errors.Count == 1 ? "" : "s")</span>
                                                                }
                                                            </span>
                                                        </span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (tab == "processes")
                        {
                            var canRecord = flowSession is { Flows: not null };
                            var opened = saved.FirstOrDefault(p => p.Id == procId);
                            var steps = StepsOf(ProcessFlows(opened));
                            var allCalls = steps.SelectMany(s => s.Calls).ToList();
                            var systems = allCalls.GroupBy(c => c.SystemKey).Select(g => (Key: g.Key, Name: g.First().System, Calls: g.Count(), Failed: g.Count(c => c.Failed || c.Soft))).ToList();
                            var nothingFound = allCalls.Count(c => c.Empty);
                            var visible = steps.Where(StepMatches).ToList();
                            var sandboxed = RepoSessions.LastOrDefault(s => s.Running && s.Sandbox is not null);

                            <div class="proc-bar">
                                @if (recordingSince is not null)
                                {
                                    <span class="rec"><span class="rec-dot on"></span> Recording “@recordingName”</span>
                                    <span class="flow-meta">@steps.Sum(s => s.Count) steps so far. Go through the process in the app, then stop.</span>
                                    <span class="spacer"></span>
                                    <button class="btn primary small" @onclick="StopRecording"><Icon Name="stop" Size="11" /> Stop and save</button>
                                    <button class="btn small" @onclick="() => recordingSince = null">Discard</button>
                                }
                                else
                                {
                                    <input class="input proc-name" placeholder="Name the process, e.g. Non-NIN registration" @bind="procName" @bind:event="oninput" />
                                    <button class="btn small rec-btn" disabled="@(flowSession is not { Flows: not null, Running: true })"
                                            title="Start recording, then go through the process in the app" @onclick="StartRecording">
                                        <span class="rec-dot"></span> Record
                                    </button>
                                    <button class="btn small" disabled="@(!canRecord)" title="Save everything captured since the app started as one process" @onclick="SaveCaptured">
                                        Save what was captured
                                    </button>
                                }
                            </div>

                            <div class="proc-list">
                                <button class="proc-chip @(opened is null ? "active" : "")" @onclick="() => OpenProcess(null)">
                                    @if (flowSession is { Running: true })
                                    {
                                        <span class="pulse"></span>
                                    }
                                    <b>Current run</b>
                                </button>
                                @foreach (var process in saved.Where(p => !p.IsFailure))
                                {
                                    <button class="proc-chip @(opened?.Id == process.Id ? "active" : "")" @onclick="() => OpenProcess(process.Id)">
                                        <Icon Name="layers" Size="14" />
                                        <b>@process.Name</b>
                                        <span class="flow-meta">@process.Created.ToString("d MMM HH:mm")</span>
                                    </button>
                                }
                            </div>

                            <div class="kept">
                                <div class="kept-head">
                                    <span class="needs-title">Kept failures</span>
                                    <span class="flow-meta">
                                        @(Keeper.Enabled
                                            ? "While an app runs here, any step that fails is kept with the steps that led to it. No need to press Record."
                                            : "Off: failures are not being kept.")
                                    </span>
                                    <span class="spacer"></span>
                                    <label class="check"><input type="checkbox" checked="@Keeper.Enabled" @onchange="e => Keeper.Enabled = (bool)e.Value!" /> Keep failures automatically</label>
                                </div>
                                @if (saved.Any(p => p.IsFailure))
                                {
                                    <div class="kept-list">
                                        @foreach (var failure in saved.Where(p => p.IsFailure))
                                        {
                                            <button class="kept-item @(opened?.Id == failure.Id ? "active" : "")" @onclick="() => OpenProcess(failure.Id)">
                                                <Icon Name="alert" Size="14" />
                                                <span class="kept-reason">@(failure.Reason ?? failure.Name)</span>
                                                <span class="flow-meta">@failure.Created.ToString("d MMM HH:mm:ss") · @failure.Env</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (sandboxed is not null)
                            {
                                <div class="callout calm">
                                    <Icon Name="shield" />
                                    <div class="replay-box">
                                        <b>@sandboxed.Target is running in the sandbox@(sandboxed.Sandbox!.Preferred is { } first ? $", answering from “{first}” first" : "").</b>
                                        <div>Use the app as you normally would. Nothing it saves, approves or sends reaches a real server.</div>
                                        @SandboxFacts(sandboxed)
                                    </div>
                                </div>
                            }

                            @if (steps.Count == 0)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="layers" Size="22" /></span>
                                    <h3>@(canRecord ? "Nothing to show yet" : "Record a process to see it end to end")</h3>
                                    <p>Run the app, press Record, and go through a process such as a registration. RepoRunner keeps every step, every call to another system, and the data sent and returned. A saved process can be reopened later, or used to run the app without the real services.</p>
                                </div>
                            }
                            else
                            {
                                var problemSteps = steps.Count(s => s.HasProblem);
                                @if (opened is { IsFailure: true })
                                {
                                    <div class="callout">
                                        <Icon Name="alert" />
                                        <div>
                                            <b>Kept automatically: @opened.Reason.</b>
                                            <div class="flow-meta">
                                                Happened at @((opened.Flows.LastOrDefault()?.FirstSeen ?? opened.Created.ToUniversalTime()).ToLocalTime().ToString("HH:mm:ss")) on @opened.Env. The failing step is the last one below@(steps.Count switch
                                                {
                                                    <= 1 => ".",
                                                    2 => "; the step before it is what led there.",
                                                    _ => $"; the {steps.Count - 1} before it are what led there.",
                                                })
                                                Open a call to re-send it once you have a fix.
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="overview">
                                    <div class="ov-top">
                                        <h3>@(opened is { IsFailure: true } ? "Failure" : opened?.Name ?? "Current run")</h3>
                                        <span class="fact"><b>@steps.Count</b> steps@(steps.Sum(s => s.Count) > steps.Count ? $" ({steps.Sum(s => s.Count)} with repeats merged)" : "")</span>
                                        <span class="fact"><b>@allCalls.Count</b> calls</span>
                                        <span class="fact">Problems in <b class="@(problemSteps > 0 ? "bad-text" : "")">@problemSteps</b> steps</span>
                                        @if (nothingFound > 0)
                                        {
                                            <span class="fact"><b>@nothingFound</b> lookups found nothing</span>
                                        }
                                        @if (opened is not null)
                                        {
                                            <span class="fact">Recorded <b>@opened.Created.ToString("d MMM HH:mm")</b> on <b>@opened.Env</b></span>
                                        }
                                        <span class="spacer"></span>
                                        <button class="btn small" disabled="@recheckRunning" title="Send every lookup in this recording again, now, and compare the answers with the recorded ones. Calls that change data are not sent."
                                                @onclick="() => Recheck(opened, steps)">
                                            <Icon Name="refresh" Size="13" /> Re-check lookups
                                        </button>
                                        @if (opened is not null)
                                        {
                                            <button class="btn primary small" title="Start the app in the sandbox. Questions it asks the same way as in this recording get this recording's answers." @onclick="() => RunAgainst(opened)">
                                                <Icon Name="play" Size="11" /> Run in the sandbox with this recording's answers
                                            </button>
                                            <button class="btn small @(confirmKey == "proc:" + opened.Id ? "confirm" : "")" @onclick="@(() => Confirm("proc:" + opened.Id, () => DeleteProcess(opened)))">
                                                <Icon Name="trash" Size="13" /> @(confirmKey == "proc:" + opened.Id ? "Click again to delete" : "Delete")
                                            </button>
                                        }
                                    </div>

                                    <div class="ov-systems">
                                        <span class="needs-title">Data moves between</span>
                                        <span class="sys"><Icon Name="monitor" Size="14" /> You</span>
                                        <Icon Name="next" Size="14" />
                                        <span class="sys app"><Icon Name="server" Size="14" /> @repo.Name</span>
                                        @if (systems.Count > 0)
                                        {
                                            <Icon Name="next" Size="14" />
                                        }
                                        @foreach (var system in systems)
                                        {
                                            <button class="sys dep @(system.Failed > 0 ? "failed" : "") @(procSystem == system.Key ? "active" : "")" title="Show only calls to @system.Key"
                                                    @onclick="() => procSystem = procSystem == system.Key ? null : system.Key">
                                                <Icon Name="globe" Size="14" />
                                                <b>@system.Name</b>
                                                <span>@system.Calls calls</span>
                                                @if (system.Failed > 0)
                                                {
                                                    <span class="bad-text">@system.Failed with problems</span>
                                                }
                                            </button>
                                        }
                                    </div>

                                    <div class="ov-tools">
                                        <label class="compare-pick" title="Line this run up against another one and show where they differ">
                                            <Icon Name="compare" Size="14" /> Compare with
                                            <select value="@(compareId ?? "")" @onchange="e => { compareId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString(); openDiff = null; }">
                                                <option value="">nothing</option>
                                                @if (opened is not null && canRecord)
                                                {
                                                    <option value="live">Current run</option>
                                                }
                                                @foreach (var other in saved.Where(p => p.Id != opened?.Id))
                                                {
                                                    <option value="@other.Id">@other.Name (@other.Created.ToString("d MMM HH:mm"))</option>
                                                }
                                            </select>
                                        </label>
                                        <div class="search">
                                            <Icon Name="search" />
                                            <input class="input" placeholder="Find a command, address or value" @bind="procFilter" @bind:event="oninput" />
                                        </div>
                                        <label class="check"><input type="checkbox" @bind="procProblemsOnly" /> Problems only</label>
                                        <label class="check"><input type="checkbox" @bind="showBackground" /> Background activity</label>
                                        <span class="spacer"></span>
                                        <button class="btn small" @onclick="() => SetAllSteps(true)">Expand all</button>
                                        <button class="btn small" @onclick="() => SetAllSteps(false)">Collapse all</button>
                                    </div>
                                </div>

                                var procKey = opened?.Id ?? "live";
                                @if (recheckRunning && recheckFor == procKey)
                                {
                                    <div class="callout calm">
                                        <Icon Name="refresh" />
                                        <div class="recheck-progress">
                                            <b>Re-checking lookups: @recheckDone of @recheckTotal sent.</b>
                                            <div class="bar"><i style="width:@Pct(recheckTotal == 0 ? 0 : recheckDone / (double)recheckTotal)"></i></div>
                                        </div>
                                        <button class="btn small" @onclick="() => recheckStop?.Cancel()">Stop</button>
                                    </div>
                                }
                                var baseline = compareId == "live" ? null : saved.FirstOrDefault(p => p.Id == compareId);
                                @if (recheckShown && !recheckRunning && recheckFor == procKey)
                                {
                                    var failedSends = recheckResults.Values.Count(r => r.Error is not null);
                                    <div class="recheck-head">
                                        <div>
                                            <b>Sent @recheckResults.Count lookups again at @recheckAt.ToString("HH:mm") and compared the answers with the recording.</b>
                                            <div class="flow-meta">
                                                @(recheckSkipped == 0 ? "" : recheckSkipped == 1 ? "1 call that changes data was not sent; it shows as unchanged. " : $"{recheckSkipped} calls that change data were not sent; they show as unchanged. ")
                                                @(failedSends == 0 ? "" : $"{failedSends} could not be sent. ")
                                                @(recheckResults.Count < recheckTotal ? $"Stopped after {recheckResults.Count} of {recheckTotal}." : "")
                                            </div>
                                        </div>
                                        <span class="spacer"></span>
                                        <button class="btn small" @onclick="() => Recheck(opened, steps)"><Icon Name="refresh" Size="13" /> Re-check again</button>
                                        <button class="btn small" @onclick="() => recheckShown = false"><Icon Name="back" Size="13" /> Back to the recording</button>
                                    </div>
                                    @CompareView(steps, Rechecked(steps), "Recorded", "Now")
                                }
                                else if (compareId is not null && (compareId == "live" || baseline is not null) && compareId != (opened?.Id ?? "live"))
                                {
                                    @CompareView(StepsOf(ProcessFlows(baseline)), steps, baseline?.Name ?? "Current run", opened?.Name ?? "Current run")
                                }
                                else
                                {
                                @if (visible.Count == 0)
                                {
                                    <div class="state small"><p>No step matches. Clear the search or untick "Problems only".</p></div>
                                }
                                <div class="psteps">
                                    @foreach (var step in visible)
                                    {
                                        var stepOpen = IsStepOpen(step, steps.Count);
                                        var calls = step.Calls.Where(CallMatches).ToList();
                                        <section class="pstep @(step.Failed ? "failed" : step.HasProblem ? "warn" : "") @(stepOpen ? "open" : "")" @key="step.Flow.TraceId">
                                            <button class="pstep-head" @onclick="() => ToggleStep(step, steps.Count)">
                                                <span class="event-n">@step.Number</span>
                                                @if (step.Verb is not null)
                                                {
                                                    <span class="verb v-@step.Verb.ToLowerInvariant()">@step.Verb</span>
                                                }
                                                <span class="pstep-title">@step.Label</span>
                                                @if (step.Page is not null)
                                                {
                                                    <span class="pstep-page">on @step.Page</span>
                                                }
                                                @if (step.Count > 1)
                                                {
                                                    <span class="times">×@step.Count</span>
                                                }
                                                <span class="pstep-sum">@step.Summary</span>
                                                <span class="flow-meta">@step.Flow.FirstSeen.ToLocalTime().ToString("HH:mm:ss")</span>
                                                <Icon Name="@(stepOpen ? "up" : "down")" Size="15" />
                                            </button>

                                            @if (stepOpen)
                                            {
                                                <div class="pstep-body">
                                                    @foreach (var error in step.Flow.Errors)
                                                    {
                                                        @ErrorCard(error)
                                                    }
                                                    @if (calls.Count == 0 && step.Flow.Errors.Count == 0)
                                                    {
                                                        <div class="flow-meta">@(step.Calls.Count == 0 ? "This step made no calls to other systems." : "No call in this step matches the filter.")</div>
                                                    }
                                                    @foreach (var call in calls)
                                                    {
                                                        var callKey = step.Flow.TraceId + "|" + call.Step.Id;
                                                        var callOpen = openCall == callKey;
                                                        <div class="pcall @(call.Failed ? "failed" : call.Soft ? "warn" : call.Empty ? "empty" : "") @(callOpen ? "open" : "")">
                                                            <button class="pcall-head" @onclick="() => openCall = callOpen ? null : callKey">
                                                                <span class="badge @(call.Failed ? "bad" : call.Soft || call.Empty ? "warn" : "ok")">@(call.Step.StatusCode?.ToString() ?? "–")</span>
                                                                <span class="pcall-name">@call.Name</span>
                                                                @if (call.Writes)
                                                                {
                                                                    <span class="chip-writes" title="Sending this call again would change data">writes</span>
                                                                }
                                                                <span class="pcall-to">@call.Verb → @call.System · @call.Endpoint</span>
                                                                @if (resent.TryGetValue(callKey, out var lastSend))
                                                                {
                                                                    var lastKind = Verdict(call, AgainCall(call, lastSend), lastSend).Kind;
                                                                    <span class="badge @(lastKind == "same" ? "ok" : lastKind == "changed" ? "warn" : "bad")">re-sent · @(lastKind == "same" ? "same" : lastKind == "changed" ? "changed" : "failed")</span>
                                                                }
                                                                <span class="pcall-ms">@call.Step.Ms.ToString("0") ms</span>
                                                                <Icon Name="@(callOpen ? "up" : "down")" Size="14" />
                                                            </button>
                                                            <div class="pcall-io">
                                                                <span class="io-label">sent</span>
                                                                @if (call.Sent.Count == 0)
                                                                {
                                                                    <span class="io-none">@(call.Body?.Request is null ? "nothing" : Size(call.Body.Request))</span>
                                                                }
                                                                @foreach (var (name, value) in call.Sent)
                                                                {
                                                                    <span class="io-pair"><i>@name</i>@value</span>
                                                                }
                                                                <span class="io-label got">returned</span>
                                                                <span class="io-result @(call.Failed ? "bad-text" : call.Soft || call.Empty ? "warn-text" : "")">@call.Returned</span>
                                                            </div>
                                                            @if (callOpen)
                                                            {
                                                                <div class="pcall-body">
                                                                    @Inside(step.Flow, call)
                                                                    @ResendPanel(call, callKey)
                                                                    @if (call.Body is null)
                                                                    {
                                                                        <div class="flow-meta">No body was captured for this call: it had none, or it was binary or a stream.</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="io-grid">@BodyCards(call.Body)</div>
                                                                    }
                                                                    <div class="flow-meta">@call.Verb @call.Step.Tag("rr.url", "url.full", "http.url")</div>
                                                                    @if (step.Flow.Stacks.TryGetValue(call.Step.Id, out var chain) && chain.Count > 0)
                                                                    {
                                                                        <div class="capture">
                                                                            <div class="capture-head"><Icon Name="code" Size="13" /> Made by your code</div>
                                                                            <div class="callers">
                                                                                @foreach (var frame in chain.Take(12))
                                                                                {
                                                                                    <button class="frame" title="Open in Rider" @onclick="() => OpenFrame(frame)">
                                                                                        <span class="frame-name">@ShortMethod(frame.Method)</span>
                                                                                        <span class="mono frame-at">@System.IO.Path.GetFileName(frame.File):@frame.Line</span>
                                                                                    </button>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                                }
                            }
                        }
                        else if (tab == "features")
                        {
                            @if (codeFeature is not null)
                            {
                                var entries = EntriesOf(codeFeature);
                                <div class="insp-head">
                                    <button class="icon-btn" title="Back to all features" @onclick="() => codeFeature = null"><Icon Name="back" /></button>
                                    <span class="verb v-@(codeFeature.Kind == "worker" ? "worker" : (codeFeature.Verb ?? "get").ToLowerInvariant())">@(codeFeature.Kind == "page" ? "PAGE" : codeFeature.Kind == "worker" ? "JOB" : codeFeature.Verb)</span>
                                    <h3>@(codeFeature.Route ?? codeFeature.Name)</h3>
                                    <span class="flow-meta">@codeFeature.File</span>
                                </div>
                                @if (code is null)
                                {
                                    <div class="state">
                                        <span class="glyph"><Icon Name="code" Size="22" /></span>
                                        <h3>Reading the code…</h3>
                                        <p>Parsing this repo's source to follow calls between its classes. This happens once per repo.</p>
                                    </div>
                                }
                                else if (entries.Count == 0)
                                {
                                    <div class="state">
                                        <span class="glyph"><Icon Name="code" Size="22" /></span>
                                        <h3>No entry method found</h3>
                                        <p>This feature's handler could not be located by name. Routes mapped to inline lambdas are not followed yet.</p>
                                    </div>
                                }
                                else
                                {
                                    var entry = entries.Contains(codeEntry ?? "") ? codeEntry! : entries[0];
                                    var trace = TraceOf(codeFeature, entry);
                                    @if (entries.Count > 1)
                                    {
                                        <div class="entry-pick">
                                            <span class="needs-title">Start from</span>
                                            @foreach (var name in entries.Take(40))
                                            {
                                                <button class="chip-btn @(name == entry ? "active" : "")" @onclick="() => codeEntry = name">@name</button>
                                            }
                                        </div>
                                    }
                                    @if (trace is null)
                                    {
                                        <div class="state small"><p>Nothing to follow from @entry.</p></div>
                                    }
                                    else
                                    {
                                        var nodes = trace.All().ToList();
                                        var reads = nodes.Where(n => n.Kind is "env").Select(n => n.Title).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                                        var settings = nodes.Where(n => n.Kind is "config").Select(n => n.Title).Distinct().ToList();
                                        <div class="needs-grid">
                                            <div class="needs">
                                                <div class="needs-title">Variables it reads</div>
                                                @if (reads.Count == 0)
                                                {
                                                    <span class="flow-meta">none on this path</span>
                                                }
                                                @foreach (var name in reads)
                                                {
                                                    var have = locked || vars.Any(v => v.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
                                                    <span class="badge mono @(have ? "ok" : "bad")" title="@(have ? $"defined in {envName}" : $"not defined in {envName}")">@name</span>
                                                }
                                                @foreach (var name in settings)
                                                {
                                                    <span class="badge mono" title="read from configuration">@name</span>
                                                }
                                            </div>
                                            <div class="needs">
                                                <div class="needs-title">What it touches</div>
                                                <span class="fact">Methods <b>@nodes.Count(n => n.Kind == "method")</b></span>
                                                <span class="fact">Calls to other services <b>@nodes.Count(n => n.Kind == "http")</b></span>
                                                <span class="fact">Database <b>@nodes.Count(n => n.Kind == "db")</b></span>
                                                <span class="fact">Can throw <b>@nodes.Count(n => n.Kind == "throw")</b></span>
                                                <span class="fact">Swallows errors <b class="@(nodes.Any(n => n.Kind == "catch") ? "warn-text" : "")">@nodes.Count(n => n.Kind == "catch")</b></span>
                                            </div>
                                        </div>
                                        liveHits = LiveHits();
                                        var ran = nodes.Count(n => n.Kind == "method" && liveHits.ContainsKey(LiveKey(n)));
                                        @if (AllFlows.Count > 0)
                                        {
                                            <div class="live-note">
                                                <span class="@(ran > 0 ? "pulse" : "lg idle")"></span>
                                                @(ran > 0
                                                    ? $"{ran} of the methods on this path were seen running in the current recording. They are marked below."
                                                    : "None of these methods has been seen running in the current recording yet. Use this feature in the app and they light up.")
                                            </div>
                                        }
                                        <div class="code-tree">
                                            @CodeTree(trace, 0)
                                        </div>
                                        <div class="flow-meta">Followed by reading the source, not by running it: calls through reflection, delegates or types outside this repo are not shown.</div>
                                    }
                                }
                            }
                            else if (scan is null)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="search" Size="22" /></span>
                                    <h3>Reading the source…</h3>
                                    <p>Listing this repo's pages, endpoints and background workers.</p>
                                </div>
                            }
                            else
                            {
                                var shownFeatures = scan.Features.Where(f => string.IsNullOrWhiteSpace(featureSearch)
                                    || (f.Route ?? "").Contains(featureSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                                    || f.Name.Contains(featureSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                                    || f.File.Contains(featureSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                                var usage = FeatureUsage();
                                <div class="toolbar">
                                    <div class="search">
                                        <Icon Name="search" />
                                        <input class="input" placeholder="Filter features" @bind="featureSearch" @bind:event="oninput" />
                                    </div>
                                    <span class="flow-meta">@scan.Features.Count features in @scan.FilesRead source files</span>
                                    <span class="spacer"></span>
                                    <button class="btn small" @onclick="Rescan"><Icon Name="refresh" Size="14" /> Scan again</button>
                                </div>
                                @if (scan.Features.Count == 0)
                                {
                                    <div class="state">
                                        <span class="glyph"><Icon Name="search" Size="22" /></span>
                                        <h3>No features recognised</h3>
                                        <p>The scan looks for Blazor pages, attribute-routed controllers, minimal API routes and hosted services.</p>
                                    </div>
                                }
                                @foreach (var group in shownFeatures.GroupBy(f => f.Kind))
                                {
                                    <div class="feature-group">@(group.Key == "page" ? "Pages" : group.Key == "endpoint" ? "API endpoints" : "Background workers") <span class="tab-count">@group.Count()</span></div>
                                    @foreach (var feature in group.Take(250))
                                    {
                                        var used = usage.GetValueOrDefault(feature);
                                        <div class="feature-row">
                                            @if (feature.Kind == "worker")
                                            {
                                                <span class="verb v-worker">JOB</span>
                                            }
                                            else
                                            {
                                                <span class="verb v-@(feature.Verb ?? "get").ToLowerInvariant()">@(feature.Kind == "page" ? "PAGE" : feature.Verb)</span>
                                            }
                                            <div class="feature-text">
                                                <span class="feature-route">@(feature.Route ?? feature.Name)</span>
                                                <span class="flow-meta">@(feature.Route is null ? "" : feature.Name + " · ")@feature.File:@feature.Line</span>
                                            </div>
                                            @if (used.Calls > 0)
                                            {
                                                <span class="badge @(used.Failed > 0 ? "bad" : "ok")">@used.Calls call@(used.Calls == 1 ? "" : "s")@(used.Failed > 0 ? $" · {used.Failed} failed" : "")</span>
                                            }
                                            <button class="btn small" title="Follow this feature through the code" @onclick="() => OpenCode(feature)"><Icon Name="code" Size="14" /> Code path</button>
                                            @if (feature.Route is not null)
                                            {
                                                <button class="btn small" title="Show only this feature on the map" @onclick="() => ShowFeature(feature)"><Icon Name="flow" Size="14" /> Map</button>
                                            }
                                            <button class="icon-btn" title="Open in Rider" @onclick="() => OpenFeature(feature)"><Icon Name="external" /></button>
                                        </div>
                                    }
                                }
                            }
                        }
                        else if (locked)
                        {
                            <div class="state locked">
                                <span class="glyph"><Icon Name="lock" Size="22" /></span>
                                <h3>@envName is protected</h3>
                                <p>Its values stay encrypted until you enter the passphrase. They then stay unlocked for @(VaultService.UnlockWindow.TotalMinutes.ToString("0")) minutes, in memory only.</p>
                                <button class="btn primary" @onclick="() => OpenUnlock(null)">
                                    <Icon Name="unlock" /> @(CurrentEnv.HasPassphrase ? $"Unlock {envName}" : "Set a passphrase")
                                </button>
                            </div>
                        }
                        else if (tab == "files")
                        {
                            @if (files.Count == 0)
                            {
                                <div class="state good">
                                    <span class="glyph"><Icon Name="shield" Size="22" /></span>
                                    <h3>No plaintext variable files</h3>
                                    <p>This repo has no .env files or launch profiles carrying variables. The vault is the only source.</p>
                                </div>
                            }
                            else
                            {
                                <div class="callout">
                                    <Icon Name="alert" />
                                    <div>These files hold variables in plain text. Import them into @envName, then delete the file so the vault is the only copy. An app that loads a .env at startup will prefer the file while it exists.</div>
                                </div>
                                @foreach (var f in files)
                                {
                                    <div class="file-row">
                                        <span class="file-glyph"><Icon Name="file" Size="18" /></span>
                                        <div class="file-body">
                                            <div class="file-name">@f.Relative</div>
                                            <div class="file-sub">
                                                @if (f.Profile is not null)
                                                {
                                                    <span>profile "@f.Profile" ·</span>
                                                }
                                                <span>@f.Pairs.Count variables</span>
                                                @if (f.InVault)
                                                {
                                                    <span class="badge ok"><Icon Name="check" Size="11" /> all in @envName</span>
                                                }
                                            </div>
                                        </div>
                                        @if (!f.InVault)
                                        {
                                            <button class="btn small" @onclick="() => ImportFile(f)"><Icon Name="download" Size="14" /> Import into @envName</button>
                                        }
                                        else if (f.Profile is null)
                                        {
                                            <button class="btn small @(confirmKey == "file:" + f.Path ? "confirm" : "stop")" @onclick="@(() => Confirm("file:" + f.Path, () => DeleteFile(f)))">
                                                <Icon Name="trash" Size="14" /> @(confirmKey == "file:" + f.Path ? "Click again to delete" : "Delete file")
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="toolbar">
                                <div class="search">
                                    <Icon Name="search" />
                                    <input class="input" placeholder="Filter variables" @bind="filter" @bind:event="oninput" />
                                </div>
                                <span class="spacer"></span>
                                <button class="btn small" @onclick="() => showPaste = !showPaste"><Icon Name="clipboard" Size="14" /> Paste .env</button>
                                <button class="btn primary small" @onclick="NewVariable"><Icon Name="plus" Size="14" /> Add variable</button>
                            </div>

                            @if (MissingReads.Count > 0)
                            {
                                <div class="callout">
                                    <Icon Name="alert" />
                                    <div>
                                        The code reads @MissingReads.Count variable@(MissingReads.Count == 1 ? "" : "s") that @envName does not define:
                                        @foreach (var read in MissingReads.Take(12))
                                        {
                                            <button class="badge warn mono missing" title="@read.File:@read.Line — click to add it" @onclick="() => AddMissing(read.Name)">@read.Name</button>
                                        }
                                        @(MissingReads.Count > 12 ? $"and {MissingReads.Count - 12} more." : "")
                                    </div>
                                </div>
                            }

                            @if (showPaste)
                            {
                                <div class="form-card">
                                    <label class="field">
                                        <span>Paste KEY=VALUE lines. They are stored encrypted for @envName and never written to a file.</span>
                                        <textarea class="input" rows="6" @bind="pasteText" placeholder="OpsApiBaseUrl=https://...&#10;ApiPassword=..."></textarea>
                                    </label>
                                    <div class="row">
                                        <button class="btn primary small" @onclick="ImportPaste">Import into @envName</button>
                                        <button class="btn small" @onclick="() => showPaste = false">Cancel</button>
                                    </div>
                                </div>
                            }

                            @if (editing)
                            {
                                <div class="form-card">
                                    <div class="grid2">
                                        <label class="field">
                                            <span>Name</span>
                                            <input class="input mono" @bind="formName" disabled="@formIsEdit" placeholder="OpsApiBaseUrl" />
                                        </label>
                                        <label class="field">
                                            <span>Value for @envName</span>
                                            <input class="input mono" type="@(formSecret ? "password" : "text")" @bind="formValue" autocomplete="off" />
                                        </label>
                                    </div>
                                    <label class="check"><input type="checkbox" @bind="formSecret" /> Secret — masked on screen and in output</label>
                                    <div class="row">
                                        <button class="btn primary small" @onclick="SaveVariable">Save</button>
                                        <button class="btn small" @onclick="() => editing = false">Cancel</button>
                                    </div>
                                </div>
                            }

                            @if (vars.Count == 0)
                            {
                                <div class="state">
                                    <span class="glyph"><Icon Name="key" Size="22" /></span>
                                    <h3>No variables for @envName yet</h3>
                                    <p>Add one, paste a .env block, or import a file from the Plaintext files tab.</p>
                                </div>
                            }
                            else
                            {
                                <table class="vars">
                                    <thead>
                                        <tr><th>Name</th><th>Value</th><th>Source</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in FilteredVars)
                                        {
                                            var own = v.Origin == "repo";
                                            var open = revealed.Contains(v.Name);
                                            <tr @key="v.Name">
                                                <td class="name">
                                                    <span class="name-cell">
                                                        @if (v.Secret)
                                                        {
                                                            <Icon Name="lock" Size="12" />
                                                        }
                                                        @v.Name
                                                    </span>
                                                </td>
                                                <td class="value @(v.Secret && !open ? "masked" : "")">@(v.Secret && !open ? "••••••••••" : v.Value)</td>
                                                <td><span class="badge">@v.Origin</span></td>
                                                <td class="tools">
                                                    @if (v.Secret)
                                                    {
                                                        <button class="icon-btn @(open ? "on" : "")" title="@(open ? "Hide value" : "Show value")" @onclick="() => ToggleReveal(v)"><Icon Name="@(open ? "eye-off" : "eye")" /></button>
                                                    }
                                                    @if (own)
                                                    {
                                                        <button class="icon-btn @(v.Secret ? "on" : "")" title="@(v.Secret ? "Secret: click to treat as a plain value" : "Plain value: click to mark as secret")" @onclick="() => ToggleSecret(v)"><Icon Name="@(v.Secret ? "lock" : "unlock")" /></button>
                                                        <button class="icon-btn" title="Edit" @onclick="() => EditVariable(v)"><Icon Name="pencil" /></button>
                                                        @if (confirmKey == "var:" + v.Name)
                                                        {
                                                            <button class="icon-btn sure" @onclick="@(() => Confirm("var:" + v.Name, () => DeleteVariable(v)))"><Icon Name="trash" Size="13" /> Delete?</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="icon-btn danger" title="Delete" @onclick="@(() => Confirm("var:" + v.Name, () => DeleteVariable(v)))"><Icon Name="trash" /></button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                </section>
            </div>
        }
    </main>
</div>

<button id="rr-palette-open" class="visually-hidden" tabindex="-1" aria-hidden="true" @onclick="OpenPalette"></button>
@if (paletteOpen)
{
    var hits = PaletteHits();
    <div class="palette-backdrop" @onclick="ClosePalette">
        <div class="palette" role="dialog" aria-label="Search everything" @onclick:stopPropagation="true">
            <input id="rr-palette-input" class="palette-input" placeholder="A page, a stored procedure, a setting, a recording…" autocomplete="off"
                   @bind="paletteQuery" @bind:event="oninput" @onkeydown="PaletteKey" />
            <div class="palette-results">
                @if (hits.Count == 0)
                {
                    <div class="palette-empty">Nothing matches “@paletteQuery”.</div>
                }
                @for (var i = 0; i < hits.Count; i++)
                {
                    var hit = hits[i];
                    <a class="palette-item @(i == Math.Min(paletteIndex, hits.Count - 1) ? "active" : "")" href="@hit.Url" @onclick="ClosePalette">
                        <span class="palette-kind">@hit.Kind</span>
                        <span class="palette-title">@hit.Title</span>
                        <span class="palette-sub">@hit.Sub</span>
                    </a>
                }
            </div>
            <div class="palette-foot">↑ ↓ to move · Enter to open · Esc to close</div>
        </div>
    </div>
}
@if (message is not null)
{
    <div class="toast @(messageIsError ? "error" : "ok")" role="status">
        <Icon Name="@(messageIsError ? "alert" : "check")" />
        <span>@message</span>
        <button class="icon-btn" title="Dismiss" @onclick="() => message = null"><Icon Name="x" Size="14" /></button>
    </div>
}

@if (showUnlock)
{
    <div class="overlay">
        <div class="dialog">
            <span class="glyph"><Icon Name="lock" Size="20" /></span>
            <h2>@(CurrentEnv.HasPassphrase ? $"Unlock {envName}" : $"Set a passphrase for {envName}")</h2>
            <p>
                @(CurrentEnv.HasPassphrase
                    ? $"Stays unlocked for {VaultService.UnlockWindow.TotalMinutes:0} minutes, in memory only."
                    : "At least 8 characters. There is no recovery if it is forgotten.")
            </p>
            <input class="input" type="password" placeholder="Passphrase" @bind="passphrase" @bind:event="oninput" @onkeydown="UnlockOnEnter" autocomplete="off" />
            @if (!CurrentEnv.HasPassphrase)
            {
                <input class="input" type="password" placeholder="Repeat it" @bind="passphraseAgain" @bind:event="oninput" @onkeydown="UnlockOnEnter" autocomplete="off" />
            }
            @if (unlockError is not null)
            {
                <div class="error-text">@unlockError</div>
            }
            <div class="row end">
                <button class="btn" @onclick="CloseUnlock">Cancel</button>
                <button class="btn primary" @onclick="Unlock">@(CurrentEnv.HasPassphrase ? "Unlock" : "Set passphrase")</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record FileItem(string Path, string Relative, string? Profile, List<KeyValuePair<string, string>> Pairs, bool InVault);

    private List<RepoInfo> repos = [];
    private List<EnvInfo> envs = [];
    private List<TargetDef> targets = [];
    private List<Variable> vars = [];
    private List<FileItem> files = [];
    private List<RunSession> sessions = [];
    private List<string> unlocked = [];
    private List<string> folderSuggestions = [];
    private List<string> solutions = [];
    private HashSet<string> openInRider = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> counts = [];
    private readonly HashSet<string> revealed = new(StringComparer.OrdinalIgnoreCase);

    private RepoInfo? repo;
    private string envName = "LOCAL";
    private bool locked;
    private RunSession? shown;
    private ElementReference logElement;

    private sealed record LogLine(string? Tag, int TagIndex, string Text, string Kind);

    private string tab = "run";
    private string? flowId;
    private string? openStep;
    private bool onlyProblems;
    private string flowFilter = "";
    private string filter = "";
    private bool hideWarnings = true;

    private string? message;
    private bool messageIsError;
    private DateTime messageAt;
    private string? confirmKey;

    private bool showAdd;
    private string addPath = "";
    private string addName = "";

    private bool editing, formIsEdit, formSecret;
    private string formName = "", formValue = "";

    private bool showPaste;
    private string pasteText = "";

    private bool showUnlock;
    private string passphrase = "", passphraseAgain = "";
    private string? unlockError;
    private Action? afterUnlock;

    private Timer? timer;
    private long seenVersion = -1;

    private EnvInfo CurrentEnv => envs.First(e => e.Name == envName);
    private List<RunSession> RepoSessions => repo is null ? [] : sessions.Where(s => s.Repo == repo.Name).ToList();

    protected override void OnInitialized()
    {
        Reload();
        if (Focused)
        {
            if (repos.FirstOrDefault(r => r.Name.Equals(FocusRepo, StringComparison.OrdinalIgnoreCase)) is { } wanted) SelectRepo(wanted);
            tab = "flow";
        }
        // Output and elapsed times change without any click; refresh twice a second while something is happening.
        timer = new Timer(_ =>
        {
            if (Keeper.Version != seenKept) InvokeAsync(() => { NoticeKept(); StateHasChanged(); });
            if (Found.Version != seenFound) { seenFound = Found.Version; InvokeAsync(StateHasChanged); }
            var version = Sessions.Version;
            if (version == seenVersion && !sessions.Any(s => s.Running) && unlocked.Count == 0 && message is null) return;
            seenVersion = version;
            InvokeAsync(() =>
            {
                sessions = Sessions.All();
                if (message is not null && !messageIsError && DateTime.Now - messageAt > TimeSpan.FromSeconds(6)) message = null;
                var nowUnlocked = Vaults.UnlockedNames();
                if (nowUnlocked.Count != unlocked.Count) Reload(); // a protected environment just timed out
                StateHasChanged();
            });
        }, null, 500, 500);
    }

    // ---------- where you are: the address bar ----------

    [Parameter] public string? RepoName { get; set; }
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? Item { get; set; }

    /// <summary>Each tab's address word and the name people see.</summary>
    private static readonly (string Tab, string Slug, string Title)[] Sections =
    [
        ("run", "run", "Run"),
        ("vars", "variables", "Variables"),
        ("output", "output", "Output"),
        ("found", "processes", "Processes"),
        ("features", "code", "Code paths"),
        ("processes", "recordings", "Recordings"),
        ("flow", "map", "Live map"),
        ("files", "files", "Plaintext files"),
    ];

    private string? appliedRoute;
    private string? pendingFeature;

    private static string Slug(string tab) => Sections.FirstOrDefault(x => x.Tab == tab).Slug ?? tab;

    private string UrlFor(RepoInfo r, string? tabKey = null, string? item = null) =>
        "repo/" + Uri.EscapeDataString(r.Name)
        + (tabKey is null ? "" : "/" + Slug(tabKey))
        + (item is null ? "" : "/" + Uri.EscapeDataString(item));

    /// <summary>Null on a repo's front page, which shows its run targets and the tab it opened on.</summary>
    private string? SectionTitle => showingSection ? Sections.FirstOrDefault(x => x.Tab == tab).Title : null;
    private bool showingSection;

    private string? ItemTitle => tab switch
    {
        "processes" => saved.FirstOrDefault(x => x.Id == procId)?.Name,
        "features" => codeFeature is null ? null : codeFeature.Route ?? codeFeature.Name,
        "found" => foundKey is null ? null : Found.For(repo!).Map?.Processes.FirstOrDefault(p => p.Key == foundKey)?.Name ?? "Process",
        "flow" => flowId is null ? null : "One request",
        _ => null,
    };

    private string? ItemKey => tab switch
    {
        "processes" => procId,
        "features" => codeFeature is null ? null : FeatureKey(codeFeature),
        "found" => foundKey is null ? null : FoundSlug(foundKey),
        "flow" => flowId,
        _ => null,
    };

    private static string FeatureKey(Feature f) => $"{f.Kind}:{f.Route ?? f.Name}";

    /// <summary>The address that shows what is on screen now.</summary>
    private string CurrentRoute() =>
        repo is null ? "" : showingSection || ItemKey is not null ? UrlFor(repo, tab, ItemKey) : UrlFor(repo);

    protected override void OnParametersSet()
    {
        if (Focused) return;
        var route = RepoName is null ? "" : "repo/" + Uri.EscapeDataString(RepoName)
            + (Section is null ? "" : "/" + Section) + (Item is null ? "" : "/" + Uri.EscapeDataString(Item));
        if (route == appliedRoute) return;
        appliedRoute = route;

        if (RepoName is null)
        {
            repo = null;
            LoadRepo();
            return;
        }
        var wanted = repos.FirstOrDefault(r => r.Name.Equals(RepoName, StringComparison.OrdinalIgnoreCase));
        if (wanted is null) { repo = null; LoadRepo(); return; }
        if (repo?.Id != wanted.Id) SelectRepo(wanted);

        var section = Sections.FirstOrDefault(x => x.Slug.Equals(Section, StringComparison.OrdinalIgnoreCase));
        showingSection = section.Tab is not null;
        if (section.Tab is null)
        {
            // The repo's front page: close whatever was open inside it.
            procId = null;
            flowId = null;
            codeFeature = null;
            foundKey = null;
            tab = RepoSessions.Any(x => x.Running) ? "output" : "run";
            return;
        }
        tab = section.Tab;
        switch (tab)
        {
            case "processes":
                procId = Item is not null && saved.Any(x => x.Id == Item) ? Item : null;
                break;
            case "flow":
                if (Item is null) CloseFlow();
                else if (flowId != Item) OpenFlow(Item, null);
                break;
            case "found":
                foundKey = Item is null ? null : Item.Replace('~', '/');
                break;
            case "features":
                if (Item is null) codeFeature = null;
                else if (scan?.Features.FirstOrDefault(f => FeatureKey(f) == Item) is { } feature) OpenCode(feature);
                else pendingFeature = Item; // opened once the scan is in
                break;
        }
    }

    /// <summary>Which look is on: "control" (dark, map-first) or "transit" (light, told stop by stop). Kept by the browser.</summary>
    private string view = "control";

    private async Task SetView(string chosen)
    {
        view = chosen;
        await JS.InvokeVoidAsync("rrSetView", chosen);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (paletteFocus)
        {
            paletteFocus = false;
            try { await JS.InvokeVoidAsync("rrFocus", "rr-palette-input"); } catch (JSException) { }
        }
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("rrGetView");
                if (saved is "control" or "transit" && saved != view) { view = saved; StateHasChanged(); }
            }
            catch (JSException) { }
        }
        // Keep the address in step with the screen, so Back, Forward and bookmarks work.
        if (!Focused)
        {
            var route = CurrentRoute();
            var now = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
            if (!string.Equals(Uri.UnescapeDataString(now), Uri.UnescapeDataString(route), StringComparison.OrdinalIgnoreCase))
            {
                appliedRoute = route;
                Nav.NavigateTo(route, new NavigationOptions { ReplaceHistoryEntry = firstRender || now.Length == 0 && repo is null });
            }
        }
        if (tab == "output" && shown is { Running: true }) await JS.InvokeVoidAsync("rrScrollEnd", logElement);
    }

