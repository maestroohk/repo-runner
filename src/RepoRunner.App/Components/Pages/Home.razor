        Say($"Opened {System.IO.Path.GetFileName(feature.File)}:{feature.Line} in Rider.");
    });

    private static string Pretty(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
        }
        catch (System.Text.Json.JsonException) { return body; }
    }

    private void OpenFrame(FlowFrame frame) => Try(() =>
    {
        if (frame.File is null) return;
        DebugSupport.OpenInRider(flowSession?.Solution, frame.File, frame.Line);
        Say($"Opened {System.IO.Path.GetFileName(frame.File)}:{frame.Line} in Rider.");
    });

    private RenderFragment ErrorCard(FlowError error) => __builder =>
    {
        var origin = error.Origin;
        <div class="error-card @(error.Unhandled ? "unhandled" : "")">
            <div class="error-top">
                <Icon Name="alert" Size="15" />
                <span class="error-type">@error.Type.Split('.').Last()</span>
                <span class="badge @(error.Unhandled ? "bad" : "warn")">@(error.Unhandled ? "unhandled" : "thrown, then handled")</span>
            </div>
            <div class="error-message">@error.Message</div>
            @if (origin is not null)
            {
                <button class="frame origin" title="Open in Rider" @onclick="() => OpenFrame(origin)">
                    <Icon Name="pin" Size="13" />
                    <span class="mono">@System.IO.Path.GetFileName(origin.File):@origin.Line</span>
                    <span class="frame-method">@origin.Method.Split('.').Last()</span>
                    <Icon Name="external" Size="12" />
                </button>
            }
            @if (error.Frames.Count > 1)
            {
                <details class="more">
                    <summary>Call stack · @error.Frames.Count frames</summary>
                    @foreach (var frame in error.Frames)
                    {
                        @if (frame.File is not null)
                        {
                            <button class="frame" title="Open in Rider" @onclick="() => OpenFrame(frame)">
                                <span class="mono">@System.IO.Path.GetFileName(frame.File):@frame.Line</span>
                                <span class="frame-method">@frame.Method</span>
                            </button>
                        }
                        else
                        {
                            <div class="frame dim"><span class="frame-method">@frame.Method</span></div>
                        }
                    }
                </details>
            }
        </div>
    };

    /// <summary>The visible lines of the selected session, classified for colour, plus how many warnings were hidden.</summary>
    private (List<LogLine> Lines, int Hidden) LogView()
    {
        var lines = new List<LogLine>();
        var tags = new List<string>();
        var hidden = 0;
        foreach (var raw in shown?.Lines() ?? [])
        {
            string? tag = null;
            var text = raw;
            var close = raw.IndexOf("] ", StringComparison.Ordinal);
            if (raw.StartsWith('[') && close is > 1 and < 32 && !raw.StartsWith("[rr-debug]"))
            {
                tag = raw[1..close].Trim();
                text = raw[(close + 2)..];
                if (!tags.Contains(tag)) tags.Add(tag);
            }
            var kind =
                text.Contains(": warning ") ? "warn"
                : text.Contains(": error ") || text.Contains("Unhandled exception") || text.Contains(" ERR]") || text.StartsWith("fail:") || text.StartsWith("Failed:") ? "err"
                : text.Contains("Now listening on") || text.Contains("started successfully") || text.Contains("debugger attached") ? "ok"
                : tag is null ? "sys" : "";
            if (kind == "warn" && hideWarnings) { hidden++; continue; }
            lines.Add(new LogLine(tag, tag is null ? 0 : tags.IndexOf(tag) % 4, text, kind));
        }
        return (lines, hidden);
    }

    private void Try(Action work)
    {
        try { work(); }
        catch (VaultException ex) { Say(ex.Message, error: true); }
    }

    private void Confirm(string key, Action action)
    {
        if (confirmKey != key) { confirmKey = key; return; }
        confirmKey = null;
        action();
    }

    private static string Elapsed(RunSession s)
    {
        var span = (s.Ended ?? DateTime.Now) - s.Started;
        return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss");
    }

    private string RunLabel(TargetDef target, string mode) =>
        confirmKey == $"run:{target.Name}:{mode}" ? $"Click again to {mode.ToLowerInvariant()} on {envName}" : mode;

    // ---------- repos and environments ----------

    private void SelectRepo(RepoInfo selected)
    {
        repo = selected;
        if (selected.DefaultEnv is { } preferred && envs.Any(e => e.Name == preferred)) envName = preferred;
        revealed.Clear();
        editing = showPaste = false;
        confirmKey = null;
        shown = null;
        filter = "";
        codeFeature = null;
        LoadRepo();
        tab = RepoSessions.Any(s => s.Running) ? "output" : "run";
    }

    private void SelectEnv(string name)
    {
        envName = name;
        revealed.Clear();
        editing = showPaste = false;
        confirmKey = null;
        var current = repo!;
        Vaults.Use(v => v.SetRepoDefaults(current, null, name)); // reopen on the environment last used
        Reload();
    }

    private void OpenAdd()
    {
        showAdd = true;
        addPath = addName = "";
        var known = repos.Select(r => r.Path).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var roots = repos.Select(r => System.IO.Path.GetDirectoryName(r.Path))
            .Append(System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "source", "repos"))
            .Where(d => d is not null && Directory.Exists(d)).Distinct(StringComparer.OrdinalIgnoreCase);
        folderSuggestions = roots.SelectMany(d => Directory.GetDirectories(d!)).Where(d => !known.Contains(d))
            .OrderBy(d => d, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void AddRepo() => Try(() =>
    {
        if (string.IsNullOrWhiteSpace(addPath)) throw new VaultException("Enter the repo's folder.");
        var added = Vaults.Use(v =>
        {
            var created = v.AddRepo(addPath.Trim().Trim('"'), string.IsNullOrWhiteSpace(addName) ? null : addName.Trim());
            var detected = Detector.Detect(created.Path);
            foreach (var target in detected.Targets) v.SaveTarget(created, target);
            v.SetRepoDefaults(created, detected.DefaultTarget, null);
            v.Audit("add", created.Name);
            return (Repo: v.GetRepo(created.Name), Count: detected.Targets.Count);
        });
        showAdd = false;
        repo = added.Repo;
        shown = null;
        Reload();
        Say($"Added {added.Repo.Name} with {added.Count} run target(s).");
    });

    // ---------- running ----------

    /// <summary>
    /// Starts a target. .NET apps on an environment that is not live run in the sandbox: a local stand-in answers their
    /// web calls (from the repo's recordings, <paramref name="preferredRecording"/> first) and nothing else leaves the machine.
    /// </summary>
    private async Task Run(TargetDef target, string mode, string? preferredRecording = null, bool sandboxOnly = false)
    {
        var env = CurrentEnv;
        if (!Vaults.IsUnlocked(env)) { OpenUnlock(() => _ = Run(target, mode, preferredRecording, sandboxOnly)); return; }
        var key = $"run:{target.Name}:{mode}";
        if (env.Protected && confirmKey != key) { confirmKey = key; return; }
        confirmKey = null;
        var sandbox = target.Kind == "dotnet" && (!env.Live || sandboxOnly);
        SandboxServer? server = null;
        try
        {
            if (sandbox)
            {
                var current = repo!;
                var recordings = await Task.Run(() => Recordings.List(current));
                server = await SandboxServer.StartAsync(recordings, preferredRecording);
                server.MirrorTo = CopyTarget(repo!, repos);
                // A protected environment (PROD) is never read from either: its lookups get recorded or made-up answers.
                server.ReadThrough = !env.Protected;
                server.KeepDataIn(System.IO.Path.Combine(Vaults.Use(v => v.RecordingsFolder(current)), "sandbox-data.json"));
                server.ReadCodeWith(CodeOf(current.Path));
                string? role;
                lock (runAs) runAs.TryGetValue(current.Name, out role);
                if (role is not null) server.RunAs(role);
            }
            shown = Sessions.Start(Vaults, repo!, env, target, watch: mode == "Watch", debug: mode == "Debug", sandbox: server);
            tab = "output";
            sessions = Sessions.All();
            if (server is not null)
                Say($"Started {target.Name} in the sandbox. {(server.Recordings == 0 ? "There are no recordings yet, so every call gets a stand-in answer." : $"Calls are answered from {server.Recordings} recording(s) where they match.")}");
        }
        catch (VaultException ex)
        {
            if (server is not null) await server.DisposeAsync();
            Say(ex.Message, error: true);
        }
    }

    /// <summary>
    /// For a sandboxed app's call: the same endpoint on another of your apps running in the sandbox here, if its
    /// scan knows a route that ends like the call's path (OpsPortal's ".../OpsApis/api/Generic/Execute" → a local
    /// OpsApi's "/api/Generic/Execute"). Worked out per call, so the other app can be started later.
    /// </summary>
    private Func<string, string, Uri?> CopyTarget(RepoInfo from, List<RepoInfo> known) => (method, pathAndQuery) =>
    {
        foreach (var other in Sessions.All().Where(s => s.Running && s.Sandbox is not null && s.Repo != from.Name && s.Url is not null))
        {
            if (known.FirstOrDefault(r => r.Name == other.Repo) is not { } otherRepo || Found.For(otherRepo).Map is not { } map) continue;
            if (CopyRoutes.Match(map, method, pathAndQuery) is not { } local) continue;
            var root = other.Url!.Replace("://0.0.0.0", "://127.0.0.1").Replace("://*", "://127.0.0.1").Replace("://+", "://127.0.0.1");
            return Uri.TryCreate(new Uri(root), local, out var target) ? target : null;
        }
        return null;
    };

    /// <summary>Each repo's code, read once per RepoRunner run and again only when its files change.</summary>
    private static readonly Dictionary<string, (string Print, Task<CodeIndex> Reading)> codeCache = new(StringComparer.OrdinalIgnoreCase);

    private static Task<CodeIndex> CodeOf(string root)
    {
        var print = Discovery.Fingerprint(root, out _);
        lock (codeCache)
        {
            if (codeCache.TryGetValue(root, out var known) && known.Print == print && !known.Reading.IsFaulted) return known.Reading;
            var reading = Task.Run(() => CodeIndex.Build(root));
            codeCache[root] = (print, reading);
            return reading;
        }
    }

    private void SetLive(EnvInfo env, bool live) => Try(() =>
    {
        if (live && env.Protected) throw new VaultException($"{env.Name} is protected. Apps run from RepoRunner never reach its servers.");
        Vaults.Use(v => v.SetLive(env, live));
        Reload();
        Say(live ? $"{env.Name} is live: apps you start on it now reach its real servers." : $"{env.Name} is sandbox-only again.");
    });

    /// <summary>What the sandbox did for a running app, in counts a support person can read.</summary>
    private RenderFragment SandboxFacts(RunSession session) => __builder =>
    {
        var hits = session.Sandbox!.Hits();
        var attempts = session.Flows?.Connections() ?? [];
        var refused = attempts.Where(a => !a.Allowed).ToList();
        var signIns = attempts.Count(a => a.Allowed);
        var recorded = hits.Count(h => h.Source is "recording" or "similar");
        var read = hits.Count(h => h.Source == "read");
        var local = hits.Count(h => h.Source == "local");
        var madeUp = hits.Count(h => h.Source is "madeup" or "taught" or "heldmadeup");
        var kept = hits.Count(h => h.Source != "read" && CallSafety.Writes(h.Method, h.Label));
        var standIn = hits.Count(h => h.Source == "synthetic");
        <div class="sandbox-facts">
            @if (session.Breach is not null)
            {
                <span class="fact bad-text"><Icon Name="alert" Size="13" /> @session.Breach</span>
            }
            else if (session.Flows is { Pid: not null, Guarded: false })
            {
                <span class="fact bad-text"><Icon Name="alert" Size="13" /> The app did not confirm its sandbox guard.</span>
            }
            else
            {
                <span class="fact ok-text"><Icon Name="shield" Size="13" /> Sandboxed</span>
            }
            <span class="fact" title="Lookups answered by the real server: reading only, nothing changed">Looked up <b>@read</b></span>
            <span class="fact" title="Calls that would save, approve, send or delete. RepoRunner answered them; nothing was sent.">Changes held back <b>@kept</b></span>
            @if (madeUp > 0)
            {
                <span class="fact" title="Lookups nobody could answer, given made-up data of the shape the app expects. Open Details to see or correct it.">Made-up answers <b>@madeUp</b></span>
            }
            @if (local > 0)
            {
                <span class="fact" title="Calls answered by another of your apps running in the sandbox on this machine">Answered locally <b>@local</b></span>
            }
            <span class="fact" title="Calls answered with what the real service said during one of your recordings">From recordings <b>@recorded</b></span>
            <span class="fact" title="Calls no recording covers. Changes get “accepted”, lookups get “nothing found”. Nothing is saved.">Stand-in answers <b>@standIn</b></span>
            <span class="fact" title="Connections the app tried to open to other machines. Each was refused before anything was sent.">Connections refused <b class="@(refused.Count > 0 ? "warn-text" : "")">@refused.Count</b></span>
            @if (signIns > 0)
            {
                <span class="fact" title="Connections to Microsoft sign-in, the only place a sandboxed app may reach">Sign-in <b>@signIns</b></span>
            }
            @{ var roles = session.Sandbox.Roles; }
            <label class="run-as" title="The role made-up sign-ins give you. Pick one seen in your recordings or type any role code, then sign out of the app and back in.">
                Run as
                <input list="roles-@session.Id" value="@roles.FirstOrDefault()" placeholder="role code" @onchange="e => RunAs(session, e.Value?.ToString()?.Trim())" />
                <datalist id="roles-@session.Id">
                    @foreach (var role in roles.Take(40))
                    {
                        <option value="@role">@session.Sandbox.RoleName(role)</option>
                    }
                </datalist>
            </label>
            @if (hits.Count > 0 || refused.Count > 0)
            {
                <details class="more">
                    <summary>Details</summary>
                    @foreach (var group in hits.GroupBy(h => (h.Source, h.Method, h.Label)).OrderByDescending(g => g.Count()).Take(40))
                    {
                        <div class="mono miss">
                            @SourceWord(group.Key.Source) · @group.Key.Method @group.Key.Label@(group.Count() > 1 ? $"  ×{group.Count()}" : "")
                            @if (group.Key.Source is "madeup" or "taught" or "heldmadeup" && group.Last() is var madeHit)
                            {
                                <button class="btn small sample-edit" @onclick="() => EditSample(session, madeHit)"><Icon Name="pencil" Size="11" /> @(sampleHit == madeHit ? "Editing" : "See or change")</button>
                            }
                        </div>
                        @if (sampleHit is not null && group.Contains(sampleHit))
                        {
                            <div class="sample-editor">
                                <div class="flow-meta">
                                    This is what the sandbox answers to <b>@sampleHit.Label</b>. It was made up to fit what the app's code expects. Change any value
                                    (names, codes, amounts) and save: it is kept for this repo and used from now on, in every sandboxed run.
                                </div>
                                <textarea class="input mono" rows="14" @bind="sampleText"></textarea>
                                @if (sampleError is not null)
                                {
                                    <div class="bad-text">@sampleError</div>
                                }
                                <div class="row">
                                    <button class="btn primary small" @onclick="() => SaveSample(session)">Keep this answer</button>
                                    <button class="btn small" @onclick="() => sampleHit = null">Close</button>
                                </div>
                            </div>
                        }
                        @if (group.Select(h => h.Problem).LastOrDefault(p => p is not null) is { } why)
                        {
                            <div class="mono miss warn-text">  could not look it up on @group.First().Host: @why</div>
                        }
                    }
                    @foreach (var group in refused.GroupBy(a => a.Host ?? a.Address).Take(20))
                    {
                        <div class="mono miss">refused · @group.Key@(group.Count() > 1 ? $"  ×{group.Count()}" : "")</div>
                    }
                </details>
            }
        </div>
    };

    private SandboxServer.Hit? sampleHit;
    private string sampleText = "";
    private string? sampleError;

    private void EditSample(RunSession session, SandboxServer.Hit hit)
    {
        if (sampleHit == hit) { sampleHit = null; return; }
        sampleHit = hit;
        sampleError = null;
        sampleText = hit.Key is null ? "" : session.Sandbox?.AnswerFor(hit.Key) ?? "";
    }

    private void SaveSample(RunSession session)
    {
        try { System.Text.Json.Nodes.JsonNode.Parse(sampleText); }
        catch (System.Text.Json.JsonException ex) { sampleError = "That is not valid JSON: " + ex.Message; return; }
        session.Sandbox?.Teach(sampleHit!, sampleText);
        sampleHit = null;
        Say("Kept. The sandbox gives this answer from now on; reload the page in the app to see it.");
    }

    private static string SourceWord(string source) => source switch
    {
        "read" => "looked up on the real server",
        "local" => "answered by your app running here",
        "madeup" => "made-up answer (from the code)",
        "heldmadeup" => "change held back, made-up answer",
        "taught" => "your sandbox data",
        "recording" => "recorded answer",
        "similar" => "recorded answer to a similar call",
        _ => "stand-in answer",
    };

    private void StopSession(RunSession session) => Sessions.Stop(session);

