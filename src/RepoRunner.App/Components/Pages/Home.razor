    /// <summary>The Run tab: how safe this environment is, which systems answer, and the targets to start.</summary>
    private RenderFragment RunZone() => __builder =>
    {
        var safetyEnv = envs.FirstOrDefault(e => e.Name == envName);
        <div class="run-zone">
                @if (safetyEnv is not null)
                {
                    <div class="safety @(safetyEnv.Live ? "live" : "sandboxed")">
                        <Icon Name="@(safetyEnv.Live ? "globe" : "shield")" Size="18" />
                        <div class="safety-text">
                            @if (safetyEnv.Live)
                            {
                                <b>@safetyEnv.Name is live.</b>
                                <span>Apps you start here talk to the real servers of @safetyEnv.Name. What they save is saved for real.</span>
                            }
                            else
                            {
                                <b>@(safetyEnv.Protected ? "Sandbox: nothing leaves this computer." : "Sandbox: nothing you save, approve or send leaves this computer.")</b>
                                @if (safetyEnv.Protected)
                                {
                                    <span>
                                        @safetyEnv.Name is protected, so a .NET app started on it reaches none of its servers, not even to look things up.
                                        RepoRunner answers every call itself, from your recordings or with made-up data. Only signing in to Microsoft goes out.
                                    </span>
                                }
                                else
                                {
                                <span>
                                    When you start a .NET app on @safetyEnv.Name, it can still look things up on @(safetyEnv.Name)'s servers (your access, lists,
                                    member details), so it works as usual. Anything that would save, approve, send or delete is answered by RepoRunner
                                    itself: “accepted”, and nothing happens. Direct connections to databases and other systems are refused.
                                </span>
                                }
                            }
                        </div>
                        @if (safetyEnv.Live)
                        {
                            <button class="btn small" @onclick="() => SetLive(safetyEnv, false)"><Icon Name="shield" Size="13" /> Back to the sandbox</button>
                        }
                        else if (!safetyEnv.Protected)
                        {
                            <button class="btn small @(confirmKey == "live:" + safetyEnv.Name ? "confirm" : "")" title="Let apps started on this environment reach its real servers"
                                    @onclick="@(() => Confirm("live:" + safetyEnv.Name, () => SetLive(safetyEnv, true)))">
                                @(confirmKey == "live:" + safetyEnv.Name ? $"Click again: real servers of {safetyEnv.Name}" : "Allow real servers")
                            </button>
                        }
                    </div>
                }

                @if (repo is not null)
                {
                @if (!locked && safetyEnv is not null)
                {
                    <div class="preflight">
                        <b>Before you run</b>
                        @if (safetyEnv.Protected)
                        {
                            <span class="flow-meta">@safetyEnv.Name is protected, so its systems are not checked.</span>
                        }
                        else if (preflight is null)
                        {
                            <span class="flow-meta">@(preflightRunning ? "Checking which systems answer…" : "Not checked yet.")</span>
                        }
                        else if (preflight.Count == 0)
                        {
                            <span class="flow-meta">No setting on @envName points at another system.</span>
                        }
                        else
                        {
                            @foreach (var system in preflight)
                            {
                                <span class="pre-chip @(system.Up ? "up" : "down")" title="@($"{system.Host}:{system.Port}" + (system.Up ? $", answered in {system.Ms} ms" : ", no answer"))">
                                    <span class="pre-dot"></span>@system.Names<i>@(system.Up ? "answering" : "not answering")</i>
                                </span>
                            }
                        }
                        @if (targets.SelectMany(t => t.Requires).Distinct(StringComparer.OrdinalIgnoreCase).Where(k => !vars.Any(x => x.Name.Equals(k, StringComparison.OrdinalIgnoreCase))).ToList() is { Count: > 0 } gone)
                        {
                            <span class="pre-chip down" title="@string.Join(", ", gone)"><span class="pre-dot"></span>@gone.Count setting@(gone.Count == 1 ? "" : "s") missing</span>
                        }
                        <span class="spacer"></span>
                        @if (!safetyEnv.Protected)
                        {
                            <button class="btn small" disabled="@preflightRunning" @onclick="() => CheckSystems(force: true)"><Icon Name="refresh" Size="12" /> Check again</button>
                        }
                    </div>
                }
                <section class="targets">
                    @if (targets.Count == 0)
                    {
                        <div class="panel">
                            <div class="state">
                                <span class="glyph"><Icon Name="terminal" Size="22" /></span>
                                <h3>No run targets found</h3>
                                <p>No runnable .NET project or npm dev script was detected in this folder.</p>
                            </div>
                        </div>
                    }
                    @foreach (var t in targets)
                    {
                        var live = sessions.FirstOrDefault(s => s.Running && s.Repo == repo.Name && s.Target == t.Name);
                        var missing = locked ? [] : t.Requires.Where(k => !vars.Any(v => v.Name.Equals(k, StringComparison.OrdinalIgnoreCase))).ToList();
                        <article class="target-card @(live is not null ? "live" : "")">
                            <div class="target-icon kind-@t.Kind">@(t.Kind == "dotnet" ? ".NET" : t.Kind == "node" ? "npm" : ">_")</div>
                            <div class="target-body">
                                <div class="target-title">
                                    @t.Name
                                    @if (t.Name.Equals(repo.DefaultTarget, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge accent">default</span>
                                    }
                                </div>
                                <div class="target-sub">
                                    @(t.Kind == "dotnet" ? t.Project : t.Kind == "node" ? $"npm run {t.Script}" : $"{t.Command} {string.Join(' ', t.Args)}")
                                    @if (t.Companions.Count > 0)
                                    {
                                        <span> · with @string.Join(", ", t.Companions)</span>
                                    }
                                </div>
                                @if (missing.Count > 0)
                                {
                                    <div class="target-warn"><Icon Name="alert" Size="14" /> @envName is missing @string.Join(", ", missing)</div>
                                }
                                @if (live?.Sandbox is not null)
                                {
                                    @SandboxFacts(live)
                                }
                                else if (live is null && safetyEnv is { Live: false } && (t.Kind != "dotnet" || t.Companions.Count > 0))
                                {
                                    <div class="target-warn" title="RepoRunner can only fence in .NET apps.">
                                        <Icon Name="alert" Size="14" />
                                        @(t.Kind != "dotnet" ? "Not a .NET app, so it cannot be sandboxed: it reaches whatever its settings point at." : $"{string.Join(", ", t.Companions)} start alongside and are not sandboxed.")
                                    </div>
                                }
                                @if (t.Kind == "dotnet" && solutions.Count > 1)
                                {
                                    <label class="solution-pick" title="Rider attaches in the window that has this solution open. Pick the one you work in.">
                                        <Icon Name="bug" Size="13" /> Debug with
                                        <select value="@SolutionOf(t)" @onchange="e => SetSolution(t, e.Value?.ToString())">
                                            @foreach (var sln in solutions)
                                            {
                                                <option value="@sln">@sln@(openInRider.Contains(sln) ? "  (open in Rider)" : "")</option>
                                            }
