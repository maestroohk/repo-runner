                                    </label>
                                }
                            </div>
                            <div class="target-actions">
                                @if (live is not null)
                                {
                                    <span class="live-pill"><span class="pulse"></span> @live.Env · @Elapsed(live)</span>
                                    @if (live.Url is not null)
                                    {
                                        <a class="btn" href="@live.Url" target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, '_blank', 'noopener'); return false;">Open app <Icon Name="external" Size="14" /></a>
                                    }
                                    <button class="btn stop" @onclick="() => StopSession(live)"><Icon Name="stop" Size="12" /> Stop</button>
                                }
                                else
                                {
                                    <button class="btn @(IsConfirming(t, "Run") ? "confirm" : "run")" @onclick="@(() => Run(t, "Run"))">
                                        <Icon Name="play" Size="12" /> @RunLabel(t, "Run")
                                    </button>
                                    @if (t.Kind == "dotnet")
                                    {
                                        <button class="btn @(IsConfirming(t, "Debug") ? "confirm" : "")" title="Start paused and attach Rider's debugger" @onclick="@(() => Run(t, "Debug"))">
                                            <Icon Name="bug" Size="15" /> @RunLabel(t, "Debug")
                                        </button>
                                        <button class="btn @(IsConfirming(t, "Watch") ? "confirm" : "")" title="dotnet watch: rebuilds when files change" @onclick="@(() => Run(t, "Watch"))">
                                            <Icon Name="refresh" Size="14" /> @RunLabel(t, "Watch")
                                        </button>
                                    }
                                }
                            </div>
                        </article>
                    }
                </section>
                }

        </div>
    };

