    private void SaveVariable() => Try(() =>
    {
        if (string.IsNullOrWhiteSpace(formName)) throw new VaultException("Give the variable a name.");
        var (current, env, name, value, secret) = (repo!, CurrentEnv, formName.Trim(), formValue, formSecret);
        Vaults.Use(v =>
        {
            v.SetVar(Scope.Repo(current.Id), env, name, value, secret);
            v.Audit("set", current.Name, env.Name, name);
        });
        editing = false;
        Reload();
        Say($"Saved {name} for {env.Name}.");
    });

    private void DeleteVariable(Variable variable) => Try(() =>
    {
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v =>
        {
            v.RemoveVar(Scope.Repo(current.Id), env, variable.Name);
            v.Audit("unset", current.Name, env.Name, variable.Name);
        });
        Reload();
    });

    private void ToggleSecret(Variable variable) => Try(() =>
    {
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v => v.SetSecret(Scope.Repo(current.Id), env, variable.Name, !variable.Secret));
        revealed.Remove(variable.Name);
        Reload();
    });

    private void ToggleReveal(Variable variable)
    {
        if (!revealed.Add(variable.Name)) { revealed.Remove(variable.Name); return; }
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v => v.Audit("reveal", current.Name, env.Name, variable.Name));
    }

    private int Store(List<KeyValuePair<string, string>> pairs, string source)
    {
        var (current, env) = (repo!, CurrentEnv);
        return Vaults.Use(v =>
        {
            foreach (var (name, value) in pairs) v.SetVar(Scope.Repo(current.Id), env, name, value);
            var stored = v.ListVars(Scope.Repo(current.Id), env, "repo").ToDictionary(x => x.Name, x => x.Value, StringComparer.OrdinalIgnoreCase);
            var bad = pairs.Where(p => !stored.TryGetValue(p.Key, out var value) || value != pairs.Last(q => q.Key.Equals(p.Key, StringComparison.OrdinalIgnoreCase)).Value)
                .Select(p => p.Key).Distinct().ToList();
            if (bad.Count > 0) throw new VaultException($"Could not verify: {string.Join(", ", bad)}.");
            v.Audit("import", current.Name, env.Name, $"{pairs.Count} from {source}");
            return pairs.Select(p => p.Key).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        });
    }

    private void ImportPaste() => Try(() =>
    {
        var pairs = DotEnv.Parse(pasteText);
        if (pairs.Count == 0) throw new VaultException("No KEY=VALUE lines found in the pasted text.");
        var count = Store(pairs, "pasted text");
        pasteText = "";
        showPaste = false;
        Reload();
        Say($"Imported and verified {count} variables into {envName}.");
    });

    private void ImportFile(FileItem file) => Try(() =>
    {
        var count = Store(file.Pairs, System.IO.Path.GetFileName(file.Path));
        Reload();
        Say($"Imported and verified {count} variables from {file.Relative} into {envName}. The file is still on disk.");
    });

    private void DeleteFile(FileItem file) => Try(() =>
    {
        // Offered only when every value in the file matches what the vault holds for this environment.
        if (!file.InVault) throw new VaultException("That file has values the vault does not hold yet. Import it first.");
        try { File.Delete(file.Path); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { throw new VaultException($"Could not delete the file: {ex.Message}"); }
        var (current, env) = (repo!, CurrentEnv);
        Vaults.Use(v => v.Audit("delete-source", current.Name, env.Name, file.Relative));
        Reload();
        Say($"Deleted {file.Relative}. {current.Name} now gets these values only from the vault.");
    });

    // ---------- protected environments ----------

    private void OpenUnlock(Action? then)
    {
        (showUnlock, passphrase, passphraseAgain, unlockError, afterUnlock) = (true, "", "", null, then);
    }

    private void CloseUnlock()
    {
        (showUnlock, passphrase, passphraseAgain, afterUnlock) = (false, "", "", null);
    }

    private void UnlockOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Unlock();
    }

    private void Unlock()
    {
        var env = CurrentEnv;
        if (!env.HasPassphrase && passphrase != passphraseAgain) { unlockError = "The two entries differ."; return; }
        try { Vaults.Unlock(env, passphrase); }
        catch (VaultException ex) { unlockError = ex.Message; return; }
        var then = afterUnlock;
        CloseUnlock();
        Reload();
        then?.Invoke();
    }

    private void LockAll()
    {
        Vaults.LockAll();
        revealed.Clear();
        Reload();
    }
