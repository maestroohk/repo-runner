<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Bricolage+Grotesque:wght@600;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <script>
        // The look chosen last time, applied before the first paint. "control" (dark, map-first) or "transit" (light, story-first).
        try { document.documentElement.dataset.view = localStorage.getItem('rr-view') || 'control'; } catch (e) { document.documentElement.dataset.view = 'control'; }
        window.rrFocus = id => { const el = document.getElementById(id); if (el) { el.focus(); el.select && el.select(); } };
        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); document.getElementById('rr-palette-open')?.click(); }
        });
        // The menu, open or folded to a rail; and one scale for the whole window, so type and boxes fit the screen.
        try { if (localStorage.getItem('rr-nav') === 'collapsed') document.documentElement.dataset.nav = 'collapsed'; } catch (e) { }
        window.rrToggleNav = () => {
            const root = document.documentElement, folded = root.dataset.nav === 'collapsed';
            if (folded) delete root.dataset.nav; else root.dataset.nav = 'collapsed';
            try { localStorage.setItem('rr-nav', folded ? 'open' : 'collapsed'); } catch (e) { }
        };
        const rrFit = () => document.documentElement.style.setProperty('--z', Math.min(1.3, Math.max(0.82, window.innerWidth / 1600)).toFixed(3));
        rrFit(); window.addEventListener('resize', rrFit);
        window.rrGetView = () => document.documentElement.dataset.view || 'control';
        window.rrSetView = v => { document.documentElement.dataset.view = v; try { localStorage.setItem('rr-view', v); } catch (e) { } };
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RepoRunner.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script>window.rrScrollEnd = el => { if (el) el.scrollTop = el.scrollHeight; };
        window.rrCopy = text => navigator.clipboard.writeText(text);</script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
